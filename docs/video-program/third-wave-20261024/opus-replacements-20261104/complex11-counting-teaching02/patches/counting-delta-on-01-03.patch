+    /// The example is the quintic the viewer has just watched, times its leading coefficient, so
+    /// the division ends on a polynomial the film has already drawn. Only the leading coefficient
+    /// and the divisor take the colour: the key is found by plain text in the source.
+    #[test]
+    fn the_example_is_the_quintic_times_its_leading_coefficient() {
+        assert_eq!(BEFORE_DIVIDING_TEX, r"f(z) = 2iz^5 - 6iz + 2{i}");
+        assert!(AFTER_DIVIDING_TEX.ends_with(r"\div 2i = z^5 - 3z + 1"));
+        assert_eq!(BEFORE_DIVIDING_TEX.matches(LEADING_KEY).count(), 1);
+        assert_eq!(AFTER_DIVIDING_TEX.matches(LEADING_KEY).count(), 1);
+        assert!(BEFORE_DIVIDING_TEX.contains(&format!("{LEADING_KEY}z^5")));
+        assert!(EVERY_OUTPUT.contains("÷ 2i") && EVERY_OUTPUT.contains("2i ≠ 0"));
+        assert!(ZERO_KEPT.starts_with("0 ÷ 2i = 0"));
+        // what the rows print is what `LEADING` computes
+        assert!((LEADING - C::new(0.0, 2.0)).abs() == 0.0);
+        let q = |z: C| Func::Quintic.eval(z).unwrap();
+        for z in circle(C::new(0.3, -0.2), 1.7, 97) {
+            let printed = C::new(0.0, 2.0) * z.powi(5) + C::new(0.0, -6.0) * z + C::new(0.0, 2.0);
+            assert!((printed - LEADING * q(z)).abs() < 1e-12 * (1.0 + printed.abs()));
+            assert!((printed / LEADING - (z.powi(5) - z.scale(3.0) + ONE)).abs() < 1e-12 * (1.0 + printed.abs()));
+        }
+    }
+
+    /// The tracker runs from the quintic (0) to the example (1), by a factor that is never 0, in
+    /// steps small enough to read as a turn.
+    #[test]
+    fn the_turn_runs_from_one_to_the_coefficient_and_never_reaches_zero() {
+        assert!((turned_by(0.0) - ONE).abs() == 0.0);
+        assert!((turned_by(1.0) - LEADING).abs() < 1e-15);
+        let steps = TURN_STEPS as usize;
+        for k in 0..=steps {
+            let t = k as f64 / TURN_STEPS;
+            let by = turned_by(t);
+            assert!(by.abs() >= 1.0 - 1e-12 && by.abs() <= LEADING.abs() + 1e-12, "{t}");
+            assert!((by.arg() - LEADING.arg() * t).abs() < 1e-12, "{t}");
+            if k < steps {
+                let step = (turned_by((k + 1) as f64 / TURN_STEPS) / by).arg();
+                assert!(step > 0.0 && step < 2f64.to_radians(), "{t}");
+            }
+        }
+    }
+
+    /// What the picture acts: at every step of the turn the five roots are still roots, no other
+    /// point has come nearer 0, the count of turns on each loop is what it was, and every output
+    /// has turned by the same angle.
+    #[test]
+    fn every_step_of_the_turn_keeps_the_roots_and_the_turns() {
+        let roots = model::quintic_roots();
+        let unit = circle(ZERO, 1.0, 720);
+        let big = circle(ZERO, 3.0, 2880);
+        for k in 0..=12 {
+            let t = f64::from(k) / 12.0;
+            let by = turned_by(t);
+            let turned = move |z: C| Func::Quintic.eval(z).map(|w| by * w);
+            for r in roots {
+                assert!(turned(r).unwrap().abs() < 1e-9, "{t}");
+            }
+            assert_eq!(winding_count(turned, &unit), Some(1), "{t}");
+            assert_eq!(winding_count(turned, &big), Some(5), "{t}");
+            for z in circle(C::new(0.4, 0.3), 0.61, 41) {
+                let (w, moved) = (Func::Quintic.eval(z).unwrap(), turned(z).unwrap());
+                assert!(moved.abs() >= w.abs() - 1e-12, "{t}");
+                assert!(((moved / w).arg() - LEADING.arg() * t).abs() < 1e-9, "{t}");
+            }
+        }
+    }
+
+    /// The turn starts from the curve 11_6's walk left, point for point, and at every step the
