+/// 11_6's output squash on the unit circle, which 11_7's curve starts from.
+const ROOT_WALK_SQUASH: f64 = 2.0;
+/// The leading coefficient of 11_7's example.
+const LEADING: C = C::new(0.0, 2.0);
+/// Repaints over the whole turn, each a step of under 2 degrees of colour.
+const TURN_STEPS: f64 = 48.0;
+/// 11_7's two rows over the colour field, where 11_6's inequality stood: the field stays uncovered.
+const OVER_FIELD: [(f64, f64); 2] = [(-3.45, 3.5), (-3.45, 2.83)];
+const ROW_PT: f64 = 32.0;
+/// Over the output plane, where 11_6's count stood and the dog's will.
+const OVER_OUTPUT: (f64, f64) = (3.25, 3.15);
+/// On the field, in input-plane units, under the lowest root and clear of the loop.
+const SAME_ROOTS_AT: (f64, f64) = (0.0, -1.72);
+
+/// What every output of the quintic is multiplied by when the picture has gone the share `t` of
+/// the way to the example: 1 at `t` = 0, [`LEADING`] at `t` = 1, turning and growing steadily.
+/// Never 0, so the turn can always be undone by dividing.
+fn turned_by(t: f64) -> C {
+    C::polar(LEADING.abs().powf(t), LEADING.arg() * t)
+}
+
+/// 11_6's output curve with each output multiplied by `by`, squashed as 11_6 squashed it.
+fn turned_curve(by: C) -> Vec<C> {
+    (0..=WALK_SAMPLES)
+        .filter_map(|j| Func::Quintic.eval(C::polar(1.0, TAU * j as f64 / WALK_SAMPLES as f64)))
+        .map(|w| squash(by * w, ROOT_WALK_SQUASH, OUT_R))
+        .collect()
+}
+
+/// 11_7's picture of the division: the quintic's colour field and output curve with every output
+/// multiplied by [`turned_by`] of a tracker. The colours turn and the bands of equal size slide,
+/// while the points where all the colours meet stay exactly where the root marks are.
+struct Turning {
+    turned: Mob,
+    anchor: Mob,
+    field: Mob,
+}
+
+impl Turning {
+    /// On screen at once and in the colours of the quintic's picture, so it can take over from
+    /// the painter unseen. `curve` is the output curve 11_6's walk left behind.
+    fn build(stage: &mut Stage<'_>, inp: Plane, out: Plane, curve: Mob) -> fmn::Result<Self> {
+        let strips = portrait(stage, Func::Quintic, &inp, 1.0)?;
+        let field = strips.group;
+        let (cols, rows) = picture_cells(&inp);
+        let turned = stage.add_value_tracker(0.0);
+        let anchor = stage.arena_mut().add(VMobject::new());
+        let mut last = 0.0;
+        stage.add_updater(
+            anchor,
+            move |s, _| {
+                let t = (value(s, turned).clamp(0.0, 1.0) * TURN_STEPS).round() / TURN_STEPS;
+                if t == last {
+                    return;
+                }
+                let by = turned_by(t);
+                let colors = portrait_colors(|z| Func::Quintic.eval(z).map(|w| by * w), &inp, cols, rows, 1.0);
+                let _ = strips.recolor(s, &colors);
+                let pts: Vec<Vec3> = turned_curve(by).into_iter().map(|w| out.p(w)).collect();
+                let _ = s.set_points(curve, polyline(pts).build().points());
+                last = t;
+            },
+            true,
+        )?;
+        stage.add_to_scene(field)?;
+        stage.add_to_scene(anchor)?;
+        Ok(Self { turned, anchor, field })
+    }
+
+    /// Stop repainting; the field is faded with the rest of the picture.
+    fn stop(&self, stage: &mut Stage<'_>) {
+        stage.clear_updaters(self.anchor, true);
+        stage.remove_from_scene(self.anchor);
+    }
+}
