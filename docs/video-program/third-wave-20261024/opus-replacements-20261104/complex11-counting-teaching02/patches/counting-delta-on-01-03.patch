+            let z = ZERO + C::polar(1.0, TAU * j as f64 / WALK_SAMPLES as f64);
+            let walked = squash(Func::Quintic.eval(z).unwrap(), ROOT_WALK_SQUASH, OUT_R);
+            assert!((*c - walked).abs() == 0.0, "{j}");
