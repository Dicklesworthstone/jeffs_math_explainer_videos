     #[test]
+    fn the_units_square_to_one_so_none_generates_all_four() {
+        let units = generators(N);
+        assert_eq!(units, [1, 5, 7, 11]);
+        for &u in &units {
+            assert_eq!(common_divisor(u, N), 1, "{u}");
+            for &w in &units {
+                assert!(units.contains(&((u * w) % N)), "{u} times {w}");
+            }
+            // The table's diagonal: every square is 1, so the powers of u are only 1 and u.
+            assert_eq!((u * u) % N, 1, "{u} squared");
+            for power in 0..4 {
+                let reached = u.pow(power) % N;
+                assert!(reached == 1 || reached == u, "{u} to the {power}");
+            }
+        }
+    }
