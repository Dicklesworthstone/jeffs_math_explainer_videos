+def sentence_opens(text):
+    """The byte where each of the kit's sentences opens; the first opens at byte 0. A byte belongs to the last
+    sentence opening at or before it, the rule the films' phrase_seconds use to place a phrase in its sentence."""
+    return [0] + [len(text[:a].encode()) for a, _z in kit_sentences(text)[1:]]
+
+
+def mark_outside_sentence(text, onsets_s, length_s, byte, seconds):
+    """None when a phrase mark lies inside the sentence holding its byte, else why not. That sentence runs from its
+    onset (included) to the next sentence's onset or, for the last sentence, to the recording's length (excluded,
+    as the kit refuses a mark at or past the length). Onsets and length are seconds as the kit computes them,
+    samples / rate."""
+    opens = sentence_opens(text)
+    if len(opens) != len(onsets_s):
+        return f"the text has {len(opens)} sentences, the timing {len(onsets_s)}"
+    k = max(j for j, at in enumerate(opens) if at <= byte)
+    lo = onsets_s[k]
+    hi, edge = (onsets_s[k + 1], f"the onset of sentence {k + 1}") if k + 1 < len(onsets_s) else (length_s, "the recording's end")
+    if lo <= seconds < hi:
+        return None
+    return f"the mark at byte {byte} ({seconds} s) is not inside its sentence {k}, which runs from {lo} s up to {edge} at {hi} s"
+
+
