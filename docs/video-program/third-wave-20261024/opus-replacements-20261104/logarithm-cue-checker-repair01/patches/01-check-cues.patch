+# ------------------------------------------------------------------- Rust tokens
+
+RAW_STRING = re.compile(r'(?:b|c)?r(#*)"')
+PREFIXED_STRING = re.compile(r'[bc]"')
+IDENT = re.compile(r"(?:r#)?[^\W\d]\w*")
+NUMBER = re.compile(r"[0-9]\w*")
