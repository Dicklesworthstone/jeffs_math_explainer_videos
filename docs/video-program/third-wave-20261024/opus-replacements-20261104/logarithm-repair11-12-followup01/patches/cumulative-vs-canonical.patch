+/// Words give way to words in the same place: the old ones leave first, so the
+/// two never print over each other.
+fn reword(stage: &mut Stage<'_>, out: &[Mob], inn: &[Mob], rt: f64) -> fmn::Result<()> {
+    fade_out_all(stage, out, rt / 2.0)?;
