+    for n in [1, 2, 4, 8] {
+        let at = v(ruler_x(f64::from(n)), y + RULER_LABEL);
+        parts.push(kit.text(stage, &n.to_string(), 14.0, c, at)?);
+    }
+    group(stage, &parts)
