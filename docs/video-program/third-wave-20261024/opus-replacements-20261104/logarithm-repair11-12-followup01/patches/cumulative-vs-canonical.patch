+/// A spin's run time: `longest`, or less if it must end by scene time `by`, but
+/// never under `MIN_RUN`.
+fn run_by(by: Option<f64>, now: f64, longest: f64) -> f64 {
+    by.map_or(longest, |at| (at - now).clamp(MIN_RUN, longest))
 }
 
