+/// Whether `m` sends the direction `d` straight back: to a negative multiple of itself.
+fn reverses(m: M2, d: [f64; 2]) -> bool {
+    let q = model::apply(m, d);
+    (d[0] * q[1] - d[1] * q[0]).abs() < 1e-9 && d[0] * q[0] + d[1] * q[1] < 0.0
