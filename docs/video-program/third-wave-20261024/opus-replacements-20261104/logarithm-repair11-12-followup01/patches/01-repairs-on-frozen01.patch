+
+/// How long `text` takes to read at `READING_RATE`, seconds.
+fn read_seconds(text: &str) -> f64 {
+    text.chars().count() as f64 / READING_RATE
+}
+
+/// How long the precise rule takes to read.
+fn rule_seconds() -> f64 {
+    THEOREM.iter().map(|line| read_seconds(line)).sum()
+}
+
+/// Which block row the marker stands beside, `held` seconds into the rule's hold:
+/// none while the rule is read, then each row for its own reading time, none after.
+fn row_in_turn(held: f64, rule: f64, rows: &[f64]) -> Option<usize> {
+    if held < rule {
+        return None;
+    }
+    let mut end = rule;
+    rows.iter().position(|&seconds| {
+        end += seconds;
+        held < end
+    })
+}
