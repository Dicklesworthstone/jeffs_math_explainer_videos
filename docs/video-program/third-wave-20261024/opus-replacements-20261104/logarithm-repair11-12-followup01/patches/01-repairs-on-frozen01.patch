+# 11_7's block rows. A matching pair -c, -c is one spin, so it has a real logarithm;
+# a positive stretch has its own. The size-2 block has eigenvalue -1 twice, and a
+# real 2x2 X reaching eigenvalue -1 has eigenvalues a +- i pi (2k + 1), so e^X is
+# -e^a I whatever its stretch directions: never that block.
+def spin_log(c):
+    return [[math.log(c), -math.pi], [math.pi, math.log(c)]]
+
+
+def sheared_spin(a_, k_, shear):
+    w = math.pi * (2 * k_ + 1)
+    return [
+        [a_ + shear * w, -w - shear * shear * w],
+        [w, a_ - shear * w],
+    ]
+
 
