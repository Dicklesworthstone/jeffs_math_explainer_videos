+fn close(a: i32, b: i32) -> bool {
+    (a - b).abs() <= 1
+}
+
+/// The members of `LINE` close to `center`.
+pub(crate) fn close_to(center: i32) -> Vec<i32> {
+    LINE.filter(|&n| close(n, center)).collect()
