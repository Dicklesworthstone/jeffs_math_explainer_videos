+/// Move the walker to `to` while the sum above it changes.
+fn walk(stage: &mut Stage<'_>, walker: Mob, from: Mob, to_sum: Mob, to: i32) -> fmn::Result<()> {
+    let motion = walker
+        .animate()
+        .set_anim_args(AnimateArgs {
+            run_time: Some(0.8),
