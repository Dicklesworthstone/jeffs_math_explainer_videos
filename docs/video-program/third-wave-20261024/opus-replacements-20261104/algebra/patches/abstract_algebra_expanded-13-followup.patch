+/// 13_12: the rack calculations.
+pub(crate) const CLOSURE_PAIR: (Elem, Elem) = (R, S);
+pub(crate) const LONG_WORD: [Elem; 5] = [S, R, S, R2, S];
+pub(crate) const IDENTITY_EXAMPLE: Elem = R;
+/// Solve `a x = b` for `(a, b)`.
+pub(crate) const SOLVE: (Elem, Elem) = (R, S);
