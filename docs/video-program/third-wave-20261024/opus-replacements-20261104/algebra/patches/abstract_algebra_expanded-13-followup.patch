+        [self.frame, self.name, self.rule]
+    }
+}
+fn card(stage: &mut Stage<'_>, kit: &Kit, k: usize) -> fmn::Result<Card> {
+    let (name, rule) = LAWS[k];
+    let x = CARD_X[k];
+    Ok(Card {
+        frame: frame(stage, (x, CARD_Y), (3.15, 1.05), Palette::dim(), 2.5)?,
+        name: kit.text(stage, name, 24., Palette::hero(), v(x, CARD_Y + 0.25))?,
+        rule: kit.tex(stage, rule, 26., Palette::ink(), &[], v(x, CARD_Y - 0.22))?,
+    })
+}
+/// Brighten card `k` and frame it; the returned frame is hidden with the demo.
+fn light(stage: &mut Stage<'_>, cards: &[Card], k: usize) -> fmn::Result<Mob> {
+    let lit = frame(stage, (CARD_X[k], CARD_Y), (3.35, 1.2), Palette::gold(), 4.)?;
+    recolor(stage, &[cards[k].name], Palette::hero(), 0.25)?;
+    recolor(stage, &[cards[k].rule], Palette::ink(), 0.25)?;
+    d4g::show(stage, &[lit], 0.3)?;
+    Ok(lit)
+}
