+/// 13_11: the drawn integers, where adding zero is shown, and the step undone.
+pub(crate) const LINE: (i32, i32) = (-5, 5);
+pub(crate) const ZERO_AT: i32 = 2;
+pub(crate) const STEP: i32 = 3;
