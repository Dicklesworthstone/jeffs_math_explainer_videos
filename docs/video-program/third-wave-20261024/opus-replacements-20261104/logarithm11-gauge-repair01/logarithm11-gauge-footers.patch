+    /// The notes are rounded and say so. Each is what the live readout prints while
+    /// the clock stands at its time. Once the clock runs on, the readout leaves it,
+    /// which is what a frame with 1.222 beside the note's 1.221 shows.
+    #[test]
+    fn the_gauge_notes_say_approximately_and_match_the_readout_at_their_moments() {
+        let film = include_str!("unreachable.rs").split("#[cfg(test)]").next().unwrap();
+        for (note, t, key) in [
+            ("t = 1: ≈ {}", 1.0, "matrix.flow_det_t1"),
+            ("t = 3: ≈ {}", FLOW_TIMES.1, "matrix.flow_det_t3"),
+        ] {
+            let styled = format!("{note}\", fact(\"{key}\")?),\n            22.0,\n            blue,");
+            assert_eq!(film.matches(styled.as_str()).count(), 1, "{note}");
+            let d = model::det(model::flow(FLOW, t));
+            let printed = fact(key).unwrap();
+            assert_eq!(format!("{d:.3}"), printed, "{key}");
+            let error = (printed.parse::<f64>().unwrap() - d).abs();
+            assert!(error > 1e-6 && error < 0.0005, "{key}: {error}");
+        }
+    }
+
+    /// All three footers in ink, 5% of the frame's height clear below and clear of
+    /// what stands lowest while each shows: the gauge, the block rows, the closing line.
+    #[test]
+    fn the_footers_are_in_ink_and_clear_of_the_edge_and_the_film() {
+        let film = include_str!("unreachable.rs").split("#[cfg(test)]").next().unwrap();
+        assert_eq!(film.matches(" = footer(").count(), 3);
+        assert!(!film.contains(" = precisely("));
+        assert!(film.contains("Palette::ink(),\n        v(0.0, FOOTER_Y),"));
+        super::super::draw::probe_scene(|stage| {
+            let kit = Kit::new()?;
+            for words in [
+                "for any real linear flow, steady or not, det = exp(∫ trace dt) > 0 (Liouville)",
+                "Culver, Proc. AMS 17 (1966) 1146–1151, as stated by Higham (Handbook of Linear Algebra) and Gallier (Thm 3.4)",
+                "Gallier, arXiv 0805.0245, Theorem 3.3, proved via the Jordan form",
+            ] {
+                let m = footer(&kit, stage, words)?;
+                let bottom = stage.get_bounding_box_point(m, DOWN)[1];
+                assert!(bottom > -3.6, "{words}: {bottom}");
+                let top = stage.get_bounding_box_point(m, UP)[1];
+                assert!(top < gauge(GAUGE_RANGE.0)[1] - 0.3, "{words}: {top}");
+                assert!(top < ROWS_TOP - 3.0 * ROWS_PITCH - BRACKET_FOOT - 0.3, "{words}: {top}");
+                // "flattening matrices, like zero, ...", 22 pt at y -2.5
+                assert!(top < -2.5 - 0.12 - 0.3, "{words}: {top}");
+                let reach = stage.get_bounding_box_point(m, RIGHT)[0];
+                assert!(reach < TEXT_RIGHT, "{words}: {reach}");
+            }
+            Ok(())
+        });
     }
 
