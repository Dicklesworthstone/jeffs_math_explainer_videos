+/// The chapter's footers: `draw::precisely`'s words, in ink and lifted off the
+/// frame's edge. They stand here, after the film's code, so that no held line moves.
+const FOOTER_Y: f64 = -3.4;
+
+fn footer(kit: &Kit, stage: &mut Stage<'_>, words: &str) -> fmn::Result<Mob> {
+    kit.text(
+        stage,
+        &format!("precisely: {words}"),
+        22.0,
+        Palette::ink(),
+        v(0.0, FOOTER_Y),
+    )
 }
 
