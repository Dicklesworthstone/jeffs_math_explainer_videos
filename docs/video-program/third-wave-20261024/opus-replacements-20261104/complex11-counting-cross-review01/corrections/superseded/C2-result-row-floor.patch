+    /// The row that states the division keeps its reading time on any voice: sentence 2 still
+    /// opens the swap, and the floor can only delay it.
+    #[test]
+    fn the_division_row_keeps_its_reading_time() {
+        // as the row prints, not as its source reads
+        let printed = "p(z) = f(z) ÷ 2i = z⁵ − 3z + 1";
+        assert!(RESULT_ROW_READ * 15.0 >= printed.chars().count() as f64);
+        let source = include_str!("counting.rs");
+        let cue = &source[source.find("let line = say(&kit, stage, \"11_7\")?;").unwrap()..];
+        let find = |text: &str| cue.find(text).unwrap_or_else(|| panic!("{text}"));
+        assert!(find("fade_in_all(stage, &result, 0.3)?;") < find("let read_by ="));
+        assert!(find("let read_by =") < find("line.wait_sentence(stage, 2)?;"));
+        assert!(find("line.wait_sentence(stage, 2)?;") < find("wait_until(stage, read_by)?;"));
+        assert!(find("wait_until(stage, read_by)?;") < find("fade_out_all(stage, &[after], 0.3)?;"));
+    }
+
