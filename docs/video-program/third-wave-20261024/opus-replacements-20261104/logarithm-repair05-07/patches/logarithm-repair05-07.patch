+
+    #[test]
+    fn the_no_logarithm_word_clears_every_ring_and_its_leader_misses_the_rays() {
+        run(|stage| {
+            let kit = Kit::new()?;
+            let word = kit.text(
+                stage,
+                ZERO_WORD,
+                22.0,
+                Palette::ink(),
+                v(ZERO_WORD_AT[0], ZERO_WORD_AT[1]),
+            )?;
+            let [left, right, bottom, top] = box_of(stage, word);
+            let nearest = (left - OUT.centre[0]).hypot(top - OUT.centre[1]);
+            assert!(
+                nearest > OUT.scale * XS[XS.len() - 1].exp() + 0.1,
+                "the outer ring reaches the word"
+            );
+            let ray_end = image(C::new(IN_X.1, -PI / 4.0));
+            assert!(top < ray_end[1], "the −45° ray reaches the word");
+            assert!(right < SAFE[0] && bottom > -SAFE[1], "the word leaves the safe area");
+            // the leader leaves the ring outward and stops short of the word
+            let (from, to) = zero_leader(left, top);
+            assert!(to[1] > top && to[0] > left && to[0] < right);
+            let reach = (from[0] - OUT.centre[0]).hypot(from[1] - OUT.centre[1]);
+            assert!((reach - 0.2).abs() < 1e-12);
+            // and lies at least 5° from every ray of the grid
+            let angle = (to[1] - OUT.centre[1]).atan2(to[0] - OUT.centre[0]);
+            let off = (angle - (angle / (PI / 4.0)).round() * PI / 4.0).abs();
+            assert!(off > deg(5.0), "the leader lies {off} rad from a ray");
+            Ok(())
+        });
+    }
