 #[cfg(test)]
 mod tests {
+    use fmn::scene::{NullSceneSink, RuntimeConfig};
+
     use super::*;
+
+    /// The safe area's half width and half height.
+    const SAFE: [f64; 2] = [6.96, 3.85];
+
+    /// Run `f` as a scene's `construct`, headless, at 10 fps.
+    fn run(f: impl FnMut(&mut Stage<'_>) -> fmn::Result<()>) {
+        struct Probe<F>(F);
+        impl<F: FnMut(&mut Stage<'_>) -> fmn::Result<()>> SceneConstruct for Probe<F> {
+            fn construct(&mut self, stage: &mut Stage<'_>) -> fmn::Result<()> {
+                (self.0)(stage)
+            }
+        }
+        let config = RuntimeConfig {
+            fps: 10,
+            ..RuntimeConfig::default()
+        };
+        fmn::run_scene(&mut Probe(f), config, 7, &mut NullSceneSink).expect("the probe scene runs");
+    }
+
+    /// A mobject's typeset box: left, right, bottom, top.
+    fn box_of(stage: &Stage<'_>, m: Mob) -> [f64; 4] {
+        [
+            stage.get_bounding_box_point(m, LEFT)[0],
+            stage.get_bounding_box_point(m, RIGHT)[0],
+            stage.get_bounding_box_point(m, DOWN)[1],
+            stage.get_bounding_box_point(m, UP)[1],
+        ]
+    }
+
+    /// The top of the outermost ring.
+    fn outer_ring_top() -> f64 {
+        OUT.centre[1] + OUT.scale * XS[XS.len() - 1].exp()
+    }
+
+    #[test]
+    fn the_names_of_i_and_two_i_stand_left_of_the_axis_clear_of_zw() {
+        run(|stage| {
+            let kit = Kit::new()?;
+            let zw = fact_list("complex.mul_zw")?;
+            let pc = C::polar(zw[0], deg(zw[1]));
+            let worked = fact_list("complex.worked")?;
+            let two_i = C::polar(worked[0], deg(worked[1]));
+            let zw_word = kit.text(stage, "zw", 28.0, Palette::ink(), ARROWS.p(pc.scale(1.12)))?;
+            let two_word = kit.text_left(stage, "2i", 26.0, Palette::ink(), two_i_word_at(two_i))?;
+            let i_word = kit.text_left(stage, "i", 26.0, Palette::ink(), i_name_at())?;
+            let zw_left = box_of(stage, zw_word)[0];
+            for word in [two_word, i_word] {
+                let right = box_of(stage, word)[1];
+                assert!(right < ARROWS.centre[0] - 0.05, "a name reaches the axis");
+                assert!(right < zw_left, "a name reaches zw");
+            }
+            // i's name stays outside the unit circle, whose top it stands beside
+            let [_, right, bottom, _] = box_of(stage, i_word);
+            let nearest = (right - ARROWS.centre[0]).hypot(bottom - ARROWS.centre[1]);
+            assert!(nearest > ARROWS.scale + 0.02, "corner at radius {nearest}");
+            Ok(())
+        });
+    }
+
+    #[test]
+    fn the_lines_over_the_output_plane_clear_its_axis_and_outer_ring() {
+        run(|stage| {
+            let kit = Kit::new()?;
+            let closes = kit.text_left(stage, CLOSES, 22.0, Palette::ink(), v(OVER_OUT[0], OVER_OUT[1]))?;
+            let dial = kit.text_left(stage, DIAL, 26.0, Palette::ink(), v(OVER_OUT[0], OVER_OUT[1]))?;
+            for line in [closes, dial] {
+                let [left, right, bottom, top] = box_of(stage, line);
+                assert!(left > OUT.centre[0] + 0.1, "the axis reaches a line");
+                assert!(bottom > outer_ring_top() + 0.05, "the outer ring reaches a line");
+                assert!(right < SAFE[0] && top < 3.2, "a line leaves its place");
+            }
+            // the generic number's words share that height, left of the axis
+            let generic = fact_list("complex.generic")?;
+            let gz = C::polar(generic[0], generic[1] * PI);
+            let word = generic_word(&kit, stage, generic[0], generic[1], gz)?;
+            let [_, right, bottom, _] = box_of(stage, word);
+            assert!(right < OUT.centre[0] - 0.05, "the words reach the axis");
+            assert!(bottom > outer_ring_top() + 0.05, "the outer ring reaches the words");
+            assert_eq!(generic, vec![2.0, 0.6]);
+            Ok(())
+        });
+    }
+
+    #[test]
