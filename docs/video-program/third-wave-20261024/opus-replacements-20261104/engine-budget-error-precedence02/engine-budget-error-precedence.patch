+    /// Far longer than any race here; reached only when the choreography hangs.
+    const WATCHDOG: Duration = Duration::from_secs(30);
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    enum Race {
+        /// A frame's own refusal on its worker.
+        Refused(u64),
+        /// An emit failure that only reports this frame's dropped output.
+        Abandoned(u64),
+        /// The sink's own failure.
+        Sink,
+    }
+
+    #[derive(Clone, Copy)]
+    enum Failing {
+        Returns,
+        Panics,
+    }
+
+    #[derive(Default)]
+    struct Marks {
+        second_yielded: bool,
+        first_emitting: bool,
+        second_failed: bool,
+    }
+
+    /// Orders one race without sleeping. Frame 0 finishes its raster only once
+    /// frame 1 has been yielded, so frame 1 is submitted before frame 0 can
+    /// reach emit. Frame 1 fails only once frame 0's emit has begun, and that
+    /// emit returns only once frame 1 has failed. The coordinator runs emit
+    /// itself, so it records frame 0's emit failure before it can receive
+    /// frame 1's.
+    struct Choreography {
+        marks: Mutex<Marks>,
+        changed: Condvar,
+        failing: Failing,
+    }
+
+    impl Choreography {
+        fn mark(&self, set: impl FnOnce(&mut Marks)) {
+            set(&mut self.marks.lock().unwrap_or_else(PoisonError::into_inner));
+            self.changed.notify_all();
+        }
+
+        /// A hang panics instead, and the pipeline reports the panic.
+        fn wait(&self, what: &str, done: impl Fn(&Marks) -> bool) {
+            let marks = self.marks.lock().unwrap_or_else(PoisonError::into_inner);
+            let (_marks, wait) = self
+                .changed
+                .wait_timeout_while(marks, WATCHDOG, |marks| !done(marks))
+                .unwrap_or_else(PoisonError::into_inner);
+            assert!(!wait.timed_out(), "watchdog expired waiting for {what}");
+        }
+    }
+
+    struct Racing {
+        choreography: Choreography,
+    }
+
+    impl PipelineStages for Racing {
+        type Frame = u64;
+        type Prepared = u64;
+        type Rasterized = u64;
+        type Output = u64;
+        type Error = Race;
+
+        fn prepare(&self, frame: u64, _team: &TeamPlan) -> Result<u64, Self::Error> {
+            Ok(frame)
+        }
+
+        fn rasterize(&self, frame: u64, _team: &TeamPlan) -> Result<u64, Self::Error> {
+            let choreography = &self.choreography;
+            if frame == 0 {
+                choreography.wait("frame 1 to be yielded", |marks| marks.second_yielded);
+                return Ok(frame);
+            }
+            choreography.wait("frame 0's emit", |marks| marks.first_emitting);
+            choreography.mark(|marks| marks.second_failed = true);
+            match choreography.failing {
+                Failing::Returns => Err(Race::Refused(frame)),
+                Failing::Panics => panic!("frame {frame} panicked on its worker"),
+            }
+        }
+
+        fn convert(&self, frame: u64, _team: &TeamPlan) -> Result<u64, Self::Error> {
+            Ok(frame)
+        }
+
+        fn emit_failure_caused_by(error: &Race) -> Option<u64> {
+            match error {
+                Race::Abandoned(frame) => Some(*frame),
+                Race::Refused(_) | Race::Sink => None,
+            }
+        }
+    }
+
+    /// Frame 0's emit returns `emit_error` after frame 1 has failed.
+    fn race(emit_error: Race, failing: Failing) -> PipelineFailure<Race> {
+        let plan = plan(2, RenderIntent::Offline);
+        assert_eq!(plan.frames_in_flight, 2, "frames 0 and 1 must overlap");
+        let stages = Racing {
+            choreography: Choreography {
+                marks: Mutex::default(),
+                changed: Condvar::new(),
+                failing,
+            },
+        };
+        let choreography = &stages.choreography;
+        let events = (0..2).map(|sequence| {
+            if sequence == 1 {
+                choreography.mark(|marks| marks.second_yielded = true);
+            }
