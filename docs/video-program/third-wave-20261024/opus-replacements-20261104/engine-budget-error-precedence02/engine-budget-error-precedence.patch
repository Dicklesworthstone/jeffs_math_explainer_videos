+                events,
+                |sequence, _| {
+                    assert_eq!(sequence, 0, "only frame 0 can reach emit");
+                    choreography.mark(|marks| marks.first_emitting = true);
+                    choreography.wait("frame 1 to fail", |marks| marks.second_failed);
+                    Err(emit_error)
