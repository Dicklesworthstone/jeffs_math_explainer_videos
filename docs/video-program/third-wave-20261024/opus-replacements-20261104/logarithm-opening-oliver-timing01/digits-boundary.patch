+/// its 52 characters. A rough estimate, never measured timing. The sentence's span
+/// includes the pause before sentence 1, so on a real voice it can run late.
 const DIGITS_SHARE: f64 = 0.58;
 const DIGITS_FADE: f64 = 0.3;
 const LAPS_RUN_SHORTEST: f64 = 0.6;
 const LAY_SHORTEST: f64 = 1.0;
 const LAY_UNTIMED: f64 = 2.0;
+const SCRIPT: &str = include_str!("../../script.tsv");
+/// The word the digits must be gone by. A mark at its byte in 03_3 replaces the
+/// share; without one the share stands.
+const FORGETS_PHRASE: &str = "forgets";
+
+/// Seconds into 03_3 at which the voice reaches "forgets", if a mark says so.
+fn forgets_mark(kit: &Kit) -> Option<f64> {
+    let text = SCRIPT.lines().find_map(|row| row.strip_prefix("03_3\t"))?;
+    let byte = text.find(FORGETS_PHRASE)?;
+    kit.narrator.as_ref()?.phrase_marks("03_3").get(&byte).copied()
+}
 
