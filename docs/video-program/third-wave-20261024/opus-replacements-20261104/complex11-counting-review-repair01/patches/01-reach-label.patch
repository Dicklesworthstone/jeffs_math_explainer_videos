+    /// The two labels share one place, one after the other, and the sweep leaves it alone.
+    /// Read from this file, because no render can run here.
+    #[test]
+    fn the_reach_labels_take_turns_over_the_window() {
+        let source = include_str!("counting.rs");
+        let body = &source[source.find("fn coarse_loop(").unwrap()..];
+        let at = |text: &str| body.find(text).unwrap_or_else(|| panic!("{text}"));
+        let covers = at("let covers = kit.text(stage, REACH_COVERS, 18.0, warn(), names_at)?;");
+        let gone = at("fade_out_all(stage, &[covered, covers, refused, band], 0.3)?;");
+        let name = at("let reach_name = kit.text(stage, STEP_SKETCH[2], 18.0, derivative_teal(), names_at)?;");
+        let lit = at("fade_in_all(stage, &lit, 0.4)?;");
+        let sweep = at("let carried = stage.add_value_tracker(0.0);");
+        let played = at("stage.play(tween_linear(carried, 1.0, rt)?)?;");
+        assert!(covers < gone && gone < name && name < lit && lit < sweep && sweep < played);
+        assert!(!body[sweep..played].contains("reach_name"));
+        assert!(!body[..played].contains("C::new(0.95, -1.2)"));
+    }
