+    /// The reach's name is fixed and the disk is carried once round the unit circle, so the
+    /// label has to clear the disk at every step of the sweep, over the label's whole extent.
+    /// Half its size in scene units: 102 × 16 pixels at 90 a unit on preview02's frame 535,
+    /// rounded up. That is the drawn label, measured where it stood before this move.
+    #[test]
+    fn the_reach_disk_never_crosses_its_name() {
+        const HALF: (f64, f64) = (0.6, 0.09);
+        // half the title's width, from x = 231 to 328 on the same frame, rounded up
+        const TITLE_HALF: f64 = 0.55;
+        let (_, out) = coarse_planes();
+        let w = out.frame;
+        let unit = out.unit();
+        let reach = f64::from(model::COARSE_POWER) * TAU / model::COARSE_STEPS[1] as f64;
+        let (half_x, half_y) = (HALF.0 / unit, HALF.1 / unit);
+        let sweep = circle(ZERO, 1.0, 1440);
+        // the closest any disk of the sweep comes to a label centred at `at`, in window units;
+        // below zero, the disk is on the label
+        let clearance = |at: (f64, f64)| {
+            sweep
+                .iter()
+                .map(|c| {
+                    let dx = ((c.re - at.0).abs() - half_x).max(0.0);
+                    let dy = ((c.im - at.1).abs() - half_y).max(0.0);
+                    dx.hypot(dy) - reach
+                })
+                .fold(f64::INFINITY, f64::min)
+        };
+        // a clear gap in scene units, wider than the disk's line
+        assert!(clearance(REACH_NAMES_AT) * unit > 0.15);
+        // the place it had, where preview02's frames 548-551 show the disk on it
+        assert!(clearance((0.95, -1.2)) < 0.0);
+        // and no place inside the window would do: every label that fits in it is within the
+        // sweep, the emptiest corner included
+        for i in 0..=80 {
+            for j in 0..=80 {
+                let at = (
+                    w.x.0 + half_x + (w.x.1 - w.x.0 - 2.0 * half_x) * f64::from(i) / 80.0,
+                    w.y.0 + half_y + (w.y.1 - w.y.0 - 2.0 * half_y) * f64::from(j) / 80.0,
+                );
+                assert!(clearance(at) < 0.0, "{at:?}");
+            }
+        }
+        // whole, above the window's top edge, under its width, in the frame and clear of the title
+        let centre = out.p(C::new(REACH_NAMES_AT.0, REACH_NAMES_AT.1));
+        assert!(REACH_NAMES_AT.1 - half_y > w.y.1 + 0.05);
+        assert!(REACH_NAMES_AT.0 - half_x > w.x.0 && REACH_NAMES_AT.0 + half_x < w.x.1);
+        assert!(centre[1] + HALF.1 < 4.0);
+        assert!(centre[0] - HALF.0 > COARSE_TITLE_AT.0 + TITLE_HALF + 0.2, "{centre:?}");
+    }
