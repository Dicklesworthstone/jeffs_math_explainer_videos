+    /// 11_7 at its edges. Dividing by a leading coefficient that is not one changes neither the
+    /// roots nor the turns, and then the leash is shorter than the walker on a huge circle. A
+    /// constant makes no turns at all, which is why the claim says "nonconstant".
+    #[test]
+    fn the_division_keeps_the_count_and_a_constant_makes_no_turns() {
+        let a = C::new(2.0, -3.0);
+        let polynomial = move |z: C| Some(a * z.powi(3) + z - C::real(5.0));
+        let divided = move |z: C| Some(z.powi(3) + z / a - C::real(5.0) / a);
+        let huge = circle(ZERO, 50.0, 4000);
+        assert_eq!(winding_count(polynomial, &huge), Some(3));
+        assert_eq!(winding_count(divided, &huge), Some(3));
+        for &z in &huge {
+            let (walker, dog) = (z.powi(3), divided(z).unwrap());
+            assert!((dog - walker).abs() < walker.abs());
+            // the same polynomial, up to the factor: their zeros are the same points
+            assert!((polynomial(z).unwrap() / a - dog).abs() < 1e-9 * walker.abs());
+        }
+        assert_eq!(winding_count(move |_: C| Some(a), &huge), Some(0));
+    }
