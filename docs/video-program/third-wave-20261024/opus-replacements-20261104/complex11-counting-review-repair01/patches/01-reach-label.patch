+    /// 11_7's pictures wait on the sentences that name them. A sentence added to the cue moves
+    /// these indices, and nothing else would notice: a wrong one still runs, on the wrong words.
+    #[test]
+    fn the_roots_argument_waits_on_the_right_sentences() {
+        let said = crate::SCRIPT
+            .lines()
+            .find_map(|line| line.strip_prefix("11_7\t"))
+            .unwrap();
+        assert!(!said.contains("? ") && !said.contains("! "));
+        let sentences: Vec<&str> = said.split(". ").collect();
+        assert_eq!(sentences.len(), 7);
+        let source = include_str!("counting.rs");
+        let here = source.find("let line = say(&kit, stage, \"11_7\")?;").unwrap();
+        let end = here + source[here..].find("let line = say(&kit, stage, \"11_8\")?;").unwrap();
+        let cue = &source[here..end];
+        for (k, opens, then) in [
+            (2, "Now it starts with z to the n", "let degree_n ="),
+            (3, "On a huge circle", "fade_in_all(stage, &wide_all, 0.5)?;"),
+            (4, "Picture z to the n as a walker", "dog.show(stage)?;"),
+        ] {
+            assert!(sentences[k].starts_with(opens), "{k}: {}", sentences[k]);
+            let waited = format!("line.wait_sentence(stage, {k})?;");
+            let wait = cue.find(&waited).unwrap() + waited.len();
+            let shown = wait + cue[wait..].find(then).unwrap();
+            assert!(!cue[wait..shown].contains("wait_sentence"), "{k}: {then}");
+        }
+        // the walk lands on the count
+        assert!(sentences[6].starts_with("So there are exactly n roots"));
+        assert!(cue.contains("let rt = (line.sentence(6)? - stage.scene().time().to_f64()).max(5.0);"));
+        // the claim needs "nonconstant", on screen and said, and the said argument needs the division
+        assert!(ROOTS_CLAIM.contains("nonconstant"));
+        assert!(sentences[0].contains("every nonconstant complex polynomial"));
+        assert!(sentences[1].starts_with("Divide by its leading coefficient"));
+        assert!(sentences[2].contains("for some positive integer n"));
+    }
