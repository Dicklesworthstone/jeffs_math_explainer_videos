+    /// The name `a` turns with its sample, so the line from 0 to the sample never runs over it,
+    /// as it did at a fixed offset on preview02's frame 551, and it never sits on the output
+    /// circle's dots, as on frame 541. The glyph is 9 pixels square at 63 a window unit.
+    #[test]
+    fn the_samples_name_keeps_off_the_distance_line() {
+        const HALF_DIAGONAL: f64 = 0.1;
+        let reach = f64::from(model::COARSE_POWER) * TAU / model::COARSE_STEPS[1] as f64;
+        let zero_name = C::new(-0.25, -0.3);
+        let sweep = circle(ZERO, 1.0, 1440);
+        for &c in &sweep {
+            let at = c * A_NAME_ON_SAMPLE;
+            assert!((at / c).im.abs() > 1.5 * HALF_DIAGONAL, "{c:?}");
+            assert!((at - c).abs() + HALF_DIAGONAL < reach, "{c:?}");
+            assert!(at.abs() + HALF_DIAGONAL < 0.93, "{c:?}");
+            assert!((at - zero_name).abs() > 2.0 * HALF_DIAGONAL, "{c:?}");
+        }
+        // where the walk starts, the place the name has always had
+        assert!((ONE * A_NAME_ON_SAMPLE - (ONE + C::new(-0.28, 0.2))).abs() < 1e-12);
+        // the fixed offset it had does cross the line
+        assert!(sweep.iter().any(|&c| (C::new(-0.28, 0.2) / c).im.abs() < HALF_DIAGONAL));
+    }
+
