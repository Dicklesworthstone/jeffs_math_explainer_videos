+pub fn small_loop_mark(q: C) -> (C, C) {
+    let a = q.arg() + PI - SMALL_MARK_HALF;
+    (
+        q + C::polar(SMALL_R, a),
+        q + C::polar(SMALL_R, a + 2.0 * SMALL_MARK_HALF),
+    )
+}
