+/// 11_5's sample of X, in the gap the gauge left: its words, then a card on the row of the A
+/// and X cards, its centre this far along. Like the footers, it stands after the film's code.
+const SAMPLE_WORD_Y: f64 = 1.7;
+const SAMPLE_ROW_Y: f64 = 1.05;
+const SAMPLE_CARD_X: f64 = GAP_X + 1.35;
+const SAMPLE_CARD_SIZE: f64 = 24.0;
+
+/// 11_1 is the first "det" on screen, 11_3 the first the voice says, so its words fade in with
+/// `line` and stand under it, at `at`.
+const DET_GLOSS: &str = "(det = determinant, the signed area factor)";
+
+fn fade_in_with_gloss(kit: &Kit, stage: &mut Stage<'_>, line: Mob, at: Vec3) -> fmn::Result<Mob> {
+    let gloss = kit.text_left(stage, DET_GLOSS, 20.0, Palette::dim(), at)?;
+    fade_in_all(stage, &[line, gloss], 0.5)?;
+    Ok(gloss)
+}
+
+/// 11_8's logarithm of A: named as one complex logarithm, since this A has no principal one.
+fn complex_log_tex(big: &str) -> String {
+    format!(
+        r"\text{{a complex logarithm: }} X = \operatorname{{diag}}(\ln {big} + i\pi,\ -\ln {big} + i\pi),\quad e^{{X}} = A"
+    )
+}
+
+/// The numbers 11_5's arrows are drawn from. This X is not 11_4's sample flow, so the card
+/// says so and prints the same fact that drives the arrows. The column's letters stay general.
+fn sample_x(kit: &Kit, stage: &mut Stage<'_>, base: M2) -> fmn::Result<[Mob; 3]> {
+    let word = kit.text_left(
+        stage,
+        "here X is a new sample:",
+        18.0,
+        Palette::dim(),
+        v(GAP_X, SAMPLE_WORD_Y),
+    )?;
+    let name = kit.text_left(stage, "X =", SAMPLE_CARD_SIZE, position_c(), v(GAP_X, SAMPLE_ROW_Y))?;
+    let [[a, b], [c, d]] = base.map(|row| row.map(|x| x.to_string()));
+    let card = matrix_card(
+        kit,
+        stage,
+        [[a.as_str(), b.as_str()], [c.as_str(), d.as_str()]],
+        v(SAMPLE_CARD_X, SAMPLE_ROW_Y),
+        SAMPLE_CARD_SIZE,
+        position_c(),
+    )?;
+    Ok([word, name, card])
+}
+
+/// The routes take the probe's place and arrive with the sample that drives them.
+fn swap_in_sample(kit: &Kit, stage: &mut Stage<'_>, base: M2, out: Mob, routes: [Mob; 3]) -> fmn::Result<[Mob; 3]> {
+    let sample = sample_x(kit, stage, base)?;
+    let mut inn = routes.to_vec();
+    inn.extend(sample);
+    swap(stage, &[out], &inn, 0.4)?;
+    Ok(sample)
+}
+
+/// A tracker's tween, with `leaving` fading out over the same time: once the off-diagonal
+/// entries start to shrink, the printed sample no longer holds.
+fn tween_leaving(stage: &mut Stage<'_>, tracker: Mob, to: f64, leaving: &[Mob], rt: f64) -> fmn::Result<()> {
+    let mut anims = vec![stage.prepare(tween(tracker, to, rt)?)?];
+    for &m in leaving {
+        let a = fade_out(stage.arena_mut(), m, ORIGIN, 1.0)?;
+        anims.push(stage.prepare(a.rt(rt))?);
+    }
+    stage.play_prepared(anims)?;
+    Ok(())
+}
