+    /// Each town's held tiles, as (town, seat).
+    fn held(seats: &[u64]) -> Vec<(usize, u64)> {
+        let mut out: Vec<(usize, u64)> = Vec::new();
+        for (i, &n) in seats.iter().enumerate() {
+            out.extend((1..=n).map(|k| (i, k)));
+        }
+        out
+    }
