+    /// The outlined tile of e^z is exact: four equal sides, on the lines where the portrait
+    /// really steps, with no step inside it, and inside the window clear of the two arrows.
+    #[test]
+    fn the_exponential_tile_is_an_exact_square_on_the_band_lines() {
+        let (s, t, ep) = (model::band_step(), exp_tile(), exp_plane());
+        assert_eq!(t.len(), 5);
+        assert_eq!(t[0], t[4]);
+        for k in 0..4 {
+            assert!(((t[k + 1] - t[k]).abs() - s).abs() < 1e-12, "side {k}");
+        }
+        let shade_at = |x: f64, y: f64| model::shade(C::new(x, y).exp()).unwrap();
+        let (x0, y0) = (t[0].re, t[0].im);
+        let (xm, ym, e) = (x0 + s / 2.0, y0 + s / 2.0, 1e-6);
+        // each side is a step in the picture
+        assert!((shade_at(x0 - e, ym) - shade_at(x0 + e, ym)).abs() > 0.1);
+        assert!((shade_at(x0 + s - e, ym) - shade_at(x0 + s + e, ym)).abs() > 0.1);
+        assert!((shade_at(xm, y0 - e) - shade_at(xm, y0 + e)).abs() > 0.1);
+        assert!((shade_at(xm, y0 + s - e) - shade_at(xm, y0 + s + e)).abs() > 0.1);
+        // and across the tile each direction only climbs, so no step falls inside it
+        for k in 1..64 {
+            let (a, b) = (f64::from(k - 1) / 63.0, f64::from(k) / 63.0);
+            let inset = |u: f64| 1e-6 + (s - 2e-6) * u;
+            assert!(shade_at(x0 + inset(a), ym) < shade_at(x0 + inset(b), ym));
+            assert!(shade_at(xm, y0 + inset(a)) < shade_at(xm, y0 + inset(b)));
+        }
+        for z in &t {
+            assert!(ep.contains(*z));
+            assert!(z.re > -2.55 && z.im > -3.5, "{z:?}: reaches an arrow");
+        }
+        runs_in_order(
+            beat("05_3", "say(&kit, stage, \"05_4\")"),
+            &[
+                "line.wait_for(stage, \"exact squares\")?;",
+                "fade_in_all(stage, &[one_square], 0.3)?;",
+                "line.wait_for(stage, \"repeating every two pi\")?;",
+                "fade_in_all(stage, &[bracket, period], 0.5)?;",
+            ],
+        );
+        assert!(beat("05_4", "say(&kit, stage, \"05_5\")").contains("one_square,"));
+    }
