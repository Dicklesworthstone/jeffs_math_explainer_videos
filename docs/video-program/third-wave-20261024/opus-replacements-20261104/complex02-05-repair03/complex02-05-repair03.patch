+    fn runs_in_order(section: &str, order: &[&str]) {
+        let mut from = 0;
+        for piece in order {
+            let at = section[from..]
+                .find(piece)
+                .unwrap_or_else(|| panic!("{piece}: missing or early"));
+            from += at + piece.len();
+        }
+    }
