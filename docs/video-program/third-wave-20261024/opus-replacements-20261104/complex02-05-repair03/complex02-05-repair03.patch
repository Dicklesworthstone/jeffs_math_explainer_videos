+    /// The source of one cue's picture, up to `next`: read from the source because no render can
+    /// run here. What it does to the pixels is for the pictures to show.
+    fn beat(id: &str, next: &str) -> &'static str {
+        let source = include_str!("gallery.rs");
+        let code = &source[..source.find("#[cfg(test)]\nmod tests").unwrap()];
+        let start = code.find(&format!("say(&kit, stage, \"{id}\")")).unwrap();
+        let end = start + code[start..].find(next).unwrap();
+        &code[start..end]
+    }
