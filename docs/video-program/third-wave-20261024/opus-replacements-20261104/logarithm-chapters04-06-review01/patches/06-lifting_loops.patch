+        // back at 1 the carried value is one lap above where it began
+        let lift = unit_lift(1.0);
+        let (first, last) = (lift[0], lift[lift.len() - 1]);
+        assert!((first.re - last.re).abs() < 1e-9);
+        assert!((last.im - first.im - TAU).abs() < 1e-9);
+    }
