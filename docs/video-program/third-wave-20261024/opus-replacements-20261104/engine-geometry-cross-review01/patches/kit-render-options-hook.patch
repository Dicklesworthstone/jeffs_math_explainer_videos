+/// A film's options hook reaches every render, and a delivery render has already rebuilt its
+/// options when the hook runs: a field set earlier would be lost there.
+#[test]
+fn the_options_hook_has_the_last_word_on_every_render() {
+    use std::sync::atomic::{AtomicUsize, Ordering::SeqCst};
+    static CALLS: AtomicUsize = AtomicUsize::new(0);
+    static DELIVERY: AtomicUsize = AtomicUsize::new(0);
+    fn note(opts: &mut RenderOptions) {
+        CALLS.fetch_add(1, SeqCst);
+        if opts.ffmpeg.is_some() {
+            DELIVERY.fetch_add(1, SeqCst);
+        }
+    }
+    let out = std::env::temp_dir().join(format!("explainer_kit_hook_{}", std::process::id()));
+    let mut e = explainer(good_facts);
+    e.thumbnail = Some(|kit| Box::new(ToyThumbnail { kit }));
+    let run = |s: &str| {
+        let argv = args(&format!("{s} --out {}", out.display()));
+        explainer_kit::cli::run_with_contract_and_options(&e, argv, &out, note)
+    };
+
+    assert_eq!(run("render 01_first --res 64x36 --fps 10 --silent --crf 28"), 0);
+    // more than one call only if the kit retried a transient ffmpeg failure
+    let renders = CALLS.load(SeqCst);
+    assert!(renders >= 1);
+    assert_eq!(DELIVERY.load(SeqCst), renders);
+
+    assert_eq!(run("thumbnail --res 64x36"), 0);
+    assert_eq!(CALLS.load(SeqCst), renders + 1);
+    assert_eq!(DELIVERY.load(SeqCst), renders);
+
+    // one capture a chapter, and none for the sheet of glyphs, which draws no chapter
+    let _ = explainer_kit::cli::run_with_contract_and_options(
+        &e,
+        [String::from("glyphs"), out.join("glyphs").display().to_string()],
+        &out,
+        note,
+    );
+    assert_eq!(CALLS.load(SeqCst), renders + 3);
+    assert_eq!(DELIVERY.load(SeqCst), renders);
+}
