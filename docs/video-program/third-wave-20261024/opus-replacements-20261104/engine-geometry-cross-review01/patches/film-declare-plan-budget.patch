+/// A plate's rows carry their colours as stroke knots, and every fade or recolour of a plate holds
+/// the old knots and the new ones together, so the widest picture at this density needs
+/// 2,150,602 where the engine's default admits 1,048,576. Nothing else in the plan is raised.
+fn declare_plan_budget(opts: &mut fmn::rendering::RenderOptions) {
+    opts.plan_limits = fmn::rendering::RenderPlanLimits {
+        max_retained_profile_knots: 1 << 22,
+        ..fmn::rendering::RenderPlanLimits::default()
+    };
+}
