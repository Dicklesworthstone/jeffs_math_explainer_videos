+    fn em(c: char) -> f64 {
+        match c {
+            'i' | 'l' | ',' | '.' | ':' | ';' | '!' | '[' | ']' => 0.278,
+            'j' | 'f' => 0.306,
+            ' ' | '-' => 0.333,
+            'I' => 0.361,
