+def live_receipt(path):
+    """This job's receipt while the guard owns it. The guard rewrites it in place just after starting the job, so a read
+    can land inside that write. Only a parse failure rereads, and a receipt that never parses refuses."""
+    for _ in range(100):
+        try:
+            return json.loads(Path(path).read_text())
+        except json.JSONDecodeError:
+            time.sleep(0.1)
+    raise Refused(f"the guard's receipt never settled: {path}")
+
+
+def load_anchors():
+    """Outside this folder's seal, so pinned here: the seal over this file then covers the anchors too."""
+    need(sha(ANCHORS) == ANCHORS_SHA256, f"{ANCHORS} is not the sealed anchors.json")
+    return load(ANCHORS)
+
