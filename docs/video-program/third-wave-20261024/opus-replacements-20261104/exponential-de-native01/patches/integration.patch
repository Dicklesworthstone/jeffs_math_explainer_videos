+/// A box around a formula.
+fn boxed(stage: &mut Stage<'_>, at: Vec3, width: f64, height: f64, color: Srgb) -> fmn::Result<Mob> {
+    let r = rect(
+        v(at[0] - width / 2.0, at[1] - height / 2.0),
+        width,
+        height,
+        stroke_style(color, 2.0),
+    )?;
+    Ok(stage.arena_mut().add(r))
+}
