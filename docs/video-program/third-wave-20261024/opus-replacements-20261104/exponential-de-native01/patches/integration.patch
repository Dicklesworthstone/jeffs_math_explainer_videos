+
+const SERIES_BOX: &str = r"E(x)=\sum_{k=0}^{\infty}\frac{x^k}{k!}";
+const DERIVATIVE_BOX: &str = r"E'=E,\ E(0)=1";
+const GRID_BOX: &str = r"E(x)E(-x)=1";
+const RESULT_BOX: &str = r"y'=y,\ y(0)=1\ \Rightarrow\ y=E";
