+/// How far through 03_3's first sentence the voice has said "the digits,": 30 of
+/// its 52 characters. A rough estimate, never measured timing.
+const DIGITS_SHARE: f64 = 0.58;
+const DIGITS_FADE: f64 = 0.3;
+const LAPS_RUN_SHORTEST: f64 = 0.6;
+const LAY_SHORTEST: f64 = 1.0;
+const LAY_UNTIMED: f64 = 2.0;
+
+/// How long the lap objects take to fade and how long the dial takes to lie flat,
+/// from `now`: the digits leave when "the digits," has been said, and the lay ends
+/// on sentence 1, or a little after it if the voice is very quick.
+fn lay_beats(now: f64, spoken: Option<(f64, f64)>) -> (f64, f64) {
+    let Some((s0, s1)) = spoken else {
+        return (LAPS_RUN_SHORTEST, LAY_UNTIMED);
+    };
+    let laps = (s0 + (s1 - s0) * DIGITS_SHARE - now).max(LAPS_RUN_SHORTEST);
+    (laps, (s1 - now - laps - DIGITS_FADE).max(LAY_SHORTEST))
+}
