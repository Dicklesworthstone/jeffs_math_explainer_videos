     "source": "mark",
     "phrase_seconds_in_line": 107.52,
     "frame": 6488,
     "global": 73553,
     "slack_frames": 293,
     "late_frames": 0,
     "phrase": "So in the limit, the big circle's integral equals the small circle's"
    },
