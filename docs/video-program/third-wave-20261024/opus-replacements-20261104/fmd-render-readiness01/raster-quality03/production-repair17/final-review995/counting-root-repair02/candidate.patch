+    /// cmr10's advance widths, in ems, for the letters the cards of `NEEDS` use (TeX's cmr10.tfm;
+    /// the space is its interword space). The kit sets text of size s at s/100 scene units an em.
+    fn cmr10_ems(s: &str) -> f64 {
+        s.chars()
+            .map(|c| match c {
+                ' ' => 0.333_334,
+                ',' | 'i' | 'l' => 0.277_779,
+                'a' | 'g' | 'o' => 0.500_002,
+                'b' | 'd' | 'h' | 'n' | 'p' | 'u' => 0.555_557,
+                'c' | 'e' | 'z' => 0.444_446,
+                'f' => 0.305_557,
+                'k' | 'x' => 0.527_781,
+                'm' => 0.833_336,
+                'r' => 0.391_668,
+                's' => 0.394_445,
+                't' => 0.388_891,
+                'w' => 0.722_224,
+                _ => panic!("no cmr10 width for {c:?}"),
+            })
+            .sum()
+    }
