+    #[test]
+    fn the_moebius_images_stay_circles_with_their_true_winding() {
+        for r in fact_list("argument.rational.radii").unwrap() {
+            let (centre, radius) = moebius_image_circle(r);
+            let gain = OUT_R / (centre.abs() + radius);
+            assert!(gain.is_finite() && gain > 0.0);
+            let mut previous = Func::Moebius.eval(C::real(r)).unwrap().scale(gain);
+            let mut turn = 0.0;
+            for j in 0..=WALK_SAMPLES {
+                let z = C::polar(r, TAU * j as f64 / WALK_SAMPLES as f64);
+                let raw = Func::Moebius.eval(z).unwrap();
+                let shown = raw.scale(gain);
+                assert!(((shown - C::real(centre * gain)).abs() - radius * gain).abs() < 1e-12);
+                assert!(shown.abs() <= OUT_R + 1e-12);
+                assert!((shown / raw).arg().abs() < 1e-12);
+                if j > 0 {
+                    turn += (shown / previous).arg();
+                }
+                previous = shown;
+            }
+            assert!((turn / TAU - Walker::turns_so_far(Func::Moebius, ZERO, r, 1.0)).abs() < 1e-12);
+            // The larger input circle encloses both the zero and pole: its image
+            // circle must visibly miss zero rather than merely look D-shaped.
+            if r > model::MOEBIUS_POLE {
+                assert!((centre.abs() - radius) * gain > 0.26);
+            }
+        }
+    }
