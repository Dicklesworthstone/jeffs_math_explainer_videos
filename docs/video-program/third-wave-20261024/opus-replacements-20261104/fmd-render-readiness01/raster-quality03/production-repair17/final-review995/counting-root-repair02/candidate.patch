 /// The radius outputs are squashed into, in output-plane units.
 pub const OUT_R: f64 = 1.35;
 
+/// A real Möbius map takes |z|=r to a circle with this centre and radius.
+/// One positive scale fits that entire circle without bending it or moving zero.
+fn moebius_image_circle(r: f64) -> (f64, f64) {
+    let (a, b) = (model::MOEBIUS_ZERO, model::MOEBIUS_POLE);
+    let denominator = r * r - b * b;
+    ((r * r - a * b) / denominator, r * (b - a).abs() / denominator.abs())
+}
+
+/// Chapter 11_3 preserves the image circle itself, not just its winding number.
+/// Other chapters and the explicitly compressed quintic picture keep their own walker.
+fn moebius_circle_walker(stage: &mut Stage<'_>, r: f64, inp: Plane, out: Plane) -> fmn::Result<Walker> {
+    let (centre, radius) = moebius_image_circle(r);
+    let gain = OUT_R / (centre.abs() + radius);
+    let walked = stage.add_value_tracker(0.0);
+    let z0 = C::real(r);
+    let w0 = Func::Moebius.eval(z0).unwrap().scale(gain);
+    let in_dot = dot(stage, inp.p(z0), 0.08, input());
+    let out_dot = dot(stage, out.p(w0), 0.08, output());
+    let trail = stage.arena_mut().add(
+        polyline(vec![out.p(w0), out.p(w0)])
+            .style(line_style(output(), 4.0))
+            .build(),
+    );
+    let arrow = stage.arena_mut().add(
+        polyline(vec![out.p(ZERO), out.p(w0)])
+            .style(line_style(Palette::ink(), 3.0))
+            .build(),
+    );
+    let anchor = stage.arena_mut().add(VMobject::new());
+    let mut last = f64::NAN;
+    stage.add_updater(
+        anchor,
+        move |s, _| {
+            let t = value(s, walked).clamp(0.0, 1.0);
+            if t == last {
+                return;
+            }
+            let k = ((t * WALK_SAMPLES as f64).round() as usize).max(1);
+            let pts: Vec<Vec3> = (0..=k)
+                .filter_map(|j| {
+                    let z = C::polar(r, TAU * j as f64 / WALK_SAMPLES as f64);
+                    Func::Moebius.eval(z).map(|w| out.p(w.scale(gain)))
+                })
+                .collect();
+            s.move_to(in_dot, inp.p(C::polar(r, TAU * t)), ORIGIN);
+            if let Some(&end) = pts.last() {
+                s.move_to(out_dot, end, ORIGIN);
+                let _ = s.set_points(arrow, polyline(vec![out.p(ZERO), end]).build().points());
+            }
+            if pts.len() >= 2 {
+                let _ = s.set_points(trail, polyline(pts).build().points());
+            }
+            last = t;
+        },
+        true,
+    )?;
+    Ok(Walker {
+        walked,
+        anchor,
+        mobs: vec![trail, arrow, in_dot, out_dot],
+        f: Func::Moebius,
+        centre: ZERO,
+        r,
+    })
+}
