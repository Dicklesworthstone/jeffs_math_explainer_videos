+    /// The first hypothesis is true of the loop it names. The walker's input path, closed, winds
+    /// once counterclockwise around the zero and around the double pole, while the output drawn
+    /// in the window under the card winds once the other way: the card's loop is the input's.
+    #[test]
+    fn the_first_need_names_the_input_loop_it_is_true_of() {
+        assert_eq!(NEEDS[0], "the input loop winds once, counterclockwise");
+        let w = (-2.0, 2.0);
+        let mut marks = Func::ZeroDoublePole.zeros(w, w);
+        marks.extend(Func::ZeroDoublePole.poles(w, w).into_iter().map(|(p, _)| p));
+        assert_eq!(marks.len(), 2);
+        let mut walk = circle(ZERO, SEVERAL_R, WALK_SAMPLES);
+        walk.push(walk[0]);
+        for p in marks {
+            let turns = walk.windows(2).map(|s| ((s[1] - p) / (s[0] - p)).arg()).sum::<f64>() / TAU;
+            assert!((turns - 1.0).abs() < 1e-9, "{p:?}: {turns}");
+        }
+        assert!((Walker::turns_so_far(Func::ZeroDoublePole, ZERO, SEVERAL_R, 1.0) + 1.0).abs() < 1e-9);
+        assert_eq!(fact("argument.several.turns").ok(), Some("-1"));
+        // each card still comes in on the words that name it, so nothing moves in time
+        assert_eq!(NEEDS_SAID, ["It needs", "passes through", "and a function"]);
+    }
