+    /// Picture review final995 L11: the walk still runs counterclockwise round Q_n, and its
+    /// resting |z - c| segment is not drawn over the D_n diagonal.
+    #[test]
+    fn the_walk_rests_off_the_diagonal_and_stays_counterclockwise() {
+        let (_, _, enlarged, centre) = drawn_nest();
+        let walk: Vec<C> = (0..4).map(|k| enlarged[(WALK_START + k) % 4]).collect();
+        assert!(oriented_area(&walk) > 0.0);
+        let start = walk[0];
