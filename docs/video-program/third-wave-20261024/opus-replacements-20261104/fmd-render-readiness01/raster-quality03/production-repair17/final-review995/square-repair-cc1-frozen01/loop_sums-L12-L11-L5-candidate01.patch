+    /// Picture review final995 L5: the nest's c is named near its dot, clear of every nest
+    /// edge and of the delta-circle drawn later, joined by a leader that meets no edge.
+    #[test]
+    fn the_name_of_c_is_near_its_dot_and_clear_of_the_nest() {
+        let (nest, c, _, _) = drawn_nest();
+        let edges: Vec<(C, C)> = nest.iter().flat_map(|q| sides(&q[..])).collect();
+        let delta = 1.8 * proof_diameter(nest.last().unwrap());
+        let (name, [from, to]) = c_name_and_leader(c);
+        // half the diagonal of the 'c' glyph at 27 pt (about 0.12 by 0.12 units)
+        let glyph = 0.085;
+        let away = (name - c).abs();
+        assert!((0.4..0.7).contains(&away), "{away}");
+        assert!(edges.iter().all(|&(a, b)| point_to_segment(name, a, b) > glyph + 0.06));
+        assert!(away - glyph > delta + 0.1, "the name is clear of the delta-circle");
+        assert!((from - c).abs() > 0.07 + 0.08 && (to - name).abs() > glyph);
+        assert!(edges.iter().all(|&(a, b)| segment_gap(from, to, a, b) > 0.02));
+        let body = goursat_body();
+        assert!(body.contains("let (name_at, leader) = c_name_and_leader(c);"));
+        assert!(body.contains("&[point, point_leader, point_name]"));
+        assert!(body.contains("&[point, point_leader, point_name, neighbourhood, small]"));
+    }
