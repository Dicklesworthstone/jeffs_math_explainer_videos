+    /// Picture review final995 L12: the kept square is a true bisection quarter of Q_n,
+    /// sharing a corner with it, never a concentric half-square, and it holds c.
+    #[test]
+    fn the_kept_square_is_a_bisection_quarter_that_holds_c() {
+        let (_, _, enlarged, centre) = drawn_nest();
+        let near = |a: C, b: C| (a - b).abs() < 1e-12;
+        let quarters = proof_children(&enlarged);
+        let kept = &quarters[KEPT_QUARTER];
+        // c is a corner of every quarter, so the kept one holds c whichever is kept,
+        // and no quarter is concentric with Q_n (what the old picture drew)
+        for q in &quarters {
+            assert!(q.iter().any(|z| near(*z, centre)));
+            assert!(((q[0] + q[2]).scale(0.5) - centre).abs() > 0.5);
+        }
+        assert!(kept.iter().any(|z| enlarged.iter().any(|w| near(*z, *w))));
+        assert!((proof_diameter(kept) * 2.0 - proof_diameter(&enlarged)).abs() < 1e-12);
+        assert!((proof_perimeter(kept) * 2.0 - proof_perimeter(&enlarged)).abs() < 1e-12);
+        // its drawn diagonal is its diameter, parallel to the D_n line and well apart from it
+        let (d, k) = (enlarged[2] - enlarged[0], kept[2] - kept[0]);
+        assert!((k.abs() - proof_diameter(kept)).abs() < 1e-12);
+        assert!((d.re * k.im - d.im * k.re).abs() < 1e-12);
+        assert!(segment_gap(enlarged[0], enlarged[2], kept[0], kept[2]) > 1.0);
+        // the dim cuts run between edge midpoints through c; each half is a shared edge
+        for [a, b] in bisection_cuts(&enlarged) {
+            assert!(point_to_segment(centre, a, b) < 1e-12);
+            for (u, w) in [(a, centre), (centre, b)] {
+                let owners = quarters
+                    .iter()
+                    .filter(|q| {
+                        sides(q)
+                            .iter()
+                            .any(|&(s, t)| (near(s, u) && near(t, w)) || (near(s, w) && near(t, u)))
+                    })
+                    .count();
+                assert_eq!(owners, 2);
+            }
+        }
+        // the names stay clear: c and Q_{n+1} inside the kept quarter, D_n outside it
+        let inside = |p: C| p.re > kept[0].re && p.re < kept[2].re && p.im > kept[0].im && p.im < kept[2].im;
+        let kept_name = kept[3] + C::new(KEPT_NAME_OFFSET.0, KEPT_NAME_OFFSET.1);
+        let (c_name, d_name) = (centre + C::new(-0.22, 0.28), C::new(-1.7, 1.2));
+        assert!(inside(kept_name) && inside(c_name) && !inside(d_name));
+        let strokes: Vec<(C, C)> = sides(&enlarged)
+            .into_iter()
+            .chain(bisection_cuts(&enlarged).map(|[a, b]| (a, b)))
+            .chain([(enlarged[0], enlarged[2]), (kept[0], kept[2])])
+            .collect();
+        for (p, r) in [(kept_name, 0.28), (c_name, 0.085), (d_name, 0.17)] {
+            assert!(strokes.iter().all(|&(a, b)| point_to_segment(p, a, b) > r), "{p:?}");
+        }
+        // and the scene draws exactly this, in place of the old concentric square
+        let body = goursat_body();
+        assert!(body.contains("let quarters = proof_children(&enlarged);"));
+        assert!(body.contains("let kept = &quarters[KEPT_QUARTER];"));
+        assert!(!body.contains("(*z - centre).scale(0.5)"));
+    }
