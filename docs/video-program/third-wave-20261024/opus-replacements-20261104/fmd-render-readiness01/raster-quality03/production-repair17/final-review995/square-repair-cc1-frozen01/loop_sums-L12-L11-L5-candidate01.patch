+        assert!(((start - centre).abs() * 2.0 - proof_diameter(&enlarged)).abs() < 1e-12);
+        assert!(point_to_segment(C::new(-1.7, 1.2), centre, start) > 1.0);
+        let body = goursat_body();
+        assert!(body.contains("enlarged[(WALK_START + k) % 4]"));
+        assert!(body.contains("let moving = walk_corners;"));
+        assert!(body.contains("&[centre, walk_corners[0]]"));
+    }
