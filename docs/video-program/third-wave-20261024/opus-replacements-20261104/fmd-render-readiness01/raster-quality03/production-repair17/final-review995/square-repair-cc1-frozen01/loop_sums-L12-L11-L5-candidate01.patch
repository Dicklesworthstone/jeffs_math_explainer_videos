+/// The two cut lines of a square's bisection, edge midpoint to opposite edge midpoint:
+/// their four halves are exactly the four `proof_children` quarters' shared edges.
+fn bisection_cuts(square: &[C]) -> [[C; 2]; 2] {
+    let midpoint = |a: C, b: C| (a + b).scale(0.5);
+    let [a, b, c, d] = [square[0], square[1], square[2], square[3]];
+    [[midpoint(a, b), midpoint(d, c)], [midpoint(d, a), midpoint(b, c)]]
+}
+
+/// Where the nest's limit point is named, and its leader: from just past the dot's rim
+/// (radius 0.07) to just short of the glyph.
+fn c_name_and_leader(c: C) -> (C, [C; 2]) {
+    let at = c + C::new(C_NAME_OFFSET.0, C_NAME_OFFSET.1);
+    let toward = (at - c).scale(1.0 / (at - c).abs());
+    (at, [c + toward.scale(0.18), at - toward.scale(0.12)])
+}
