+    /// The 08_5 nest as goursat_proof draws it (the same path as the extents test above),
+    /// its limit point c, the magnified square about c, and c's place in it.
+    fn drawn_nest() -> (Vec<Vec<C>>, C, Vec<C>, C) {
+        let square = proof_square();
+        let mut nest = vec![square.clone(), proof_children(&square)[2].clone()];
+        for index in [0, 3, 1, 2] {
+            let next = proof_children(nest.last().unwrap())[index].clone();
+            nest.push(next);
+        }
+        let current = nest.last().unwrap().clone();
+        let c = (current[0] + current[2]).scale(0.5);
+        let centre = C::new(SQUARE_CENTRE.0, SQUARE_CENTRE.1);
+        let scale = proof_perimeter(&square) / proof_perimeter(&current);
+        let enlarged = current.iter().map(|z| centre + (*z - c).scale(scale)).collect();
+        (nest, c, enlarged, centre)
+    }
+
+    fn point_to_segment(p: C, a: C, b: C) -> f64 {
+        let (ab, ap) = (b - a, p - a);
+        let t = ((ap.re * ab.re + ap.im * ab.im) / (ab.re * ab.re + ab.im * ab.im)).clamp(0.0, 1.0);
+        (p - (a + ab.scale(t))).abs()
+    }
+
+    fn segment_gap(a: C, b: C, p: C, q: C) -> f64 {
+        let side = |u: C, w: C, z: C| (w - u).re * (z - u).im - (w - u).im * (z - u).re;
+        if side(a, b, p) * side(a, b, q) < 0.0 && side(p, q, a) * side(p, q, b) < 0.0 {
+            return 0.0;
+        }
+        [
+            point_to_segment(a, p, q),
+            point_to_segment(b, p, q),
+            point_to_segment(p, a, b),
+            point_to_segment(q, a, b),
+        ]
+        .into_iter()
+        .fold(f64::INFINITY, f64::min)
+    }
+
+    fn sides(p: &[C]) -> Vec<(C, C)> {
+        p.iter()
+            .zip(p.iter().cycle().skip(1))
+            .take(p.len())
+            .map(|(a, b)| (*a, *b))
+            .collect()
+    }
+
+    fn goursat_body() -> &'static str {
+        include_str!("loop_sums.rs")
+            .split("fn goursat_proof(")
+            .nth(1)
+            .unwrap()
+            .split("pub struct LoopSums")
+            .next()
+            .unwrap()
+    }
