+    /// Final review 995, M4: the disks of 09_7 (about 0, out to 1) and 09_9 (about 1, out to √2)
+    /// grew through a's name, which stands at the same place from each centre. It keeps its place
+    /// and makes way: hidden whenever a disk's line comes within CLEAR of its ink, fully shown as
+    /// each disk starts and stops.
+    #[test]
+    fn the_growing_disks_never_draw_through_a() {
+        // a's ink at size 28: a's 24 x 25 native pixels at 20, scaled, then widened to the
+        // overview's reading
+        const A_NAME_HALF: (f64, f64) = (17.5 / PX, 19.0 / PX);
+        let p = picture();
+        let (centre, unit) = (p.p(ZERO), p.unit());
+        let (inmost, outmost) = reach(centre, &label_box(p.p(A_NAME_FROM_CENTRE), A_NAME_HALF));
+        let ends = [num("bump.radius0"), num("recentre1.radius")];
+        let mut hidden = 0;
+        for k in 0..=4000 {
+            let r = 1e-3 + (ends[1] - 1e-3) * f64::from(k) / 4000.0;
+            // the disks' lines are width 5
+            if r * unit + 0.025 + CLEAR > inmost && r * unit - 0.025 - CLEAR < outmost {
+                assert!(a_name_shown(r) < 1e-12, "{r}");
+                hidden += 1;
+            }
+        }
+        assert!(hidden > 0);
+        for r in [1e-3, ends[0], ends[1]] {
+            assert!(a_name_shown(r) > 1.0 - 1e-12, "{r}");
+        }
+    }
