+    /// Freeze a camera-bound frame for worker-owned rasterization.
+    ///
+    /// Call this only on the live Stage's owner, after its capture barrier.
+    /// Geometry, painter order, uniforms, image resources, and camera state are
+    /// captured now; subsequent edits, exported-view writes, and scene teardown
+    /// cannot affect the returned job. No arena, callback, or Python proxy is
+    /// transferred. Rasterization uses the same implementation as
+    /// [`Self::render_with_camera`], not a second renderer.
+    ///
+    /// Acquire the runtime pipeline's source permit BEFORE calling this method
+    /// so frozen geometry is included in its bounded frame count.
+    ///
+    /// # Errors
+    /// The same record/topology validation errors as the synchronous route.
+    pub fn prepare_with_camera(
+        &mut self,
+        stage: &Stage,
+        camera: &Camera,
+    ) -> Result<PreparedCameraFrame, RetainedFrameRendererError> {
+        let scene = prepare_camera_scene(&mut self.plan, stage, camera)?;
+        self.plan.commit_image_frame(scene.images.clone());
+        Ok(PreparedCameraFrame {
+            plan: self.plan.clone(), scene, camera: camera.clone(),
+            tiling: self.config.tiling,
+        })
+    }
+
