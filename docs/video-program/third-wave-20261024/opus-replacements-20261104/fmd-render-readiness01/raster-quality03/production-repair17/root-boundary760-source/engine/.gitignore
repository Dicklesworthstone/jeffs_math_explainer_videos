scripts/videos_ref/

# Non-member spike build output + the importable-module symlink run.sh makes
spikes/*/target/
spikes/g0-5-python-ext/py/*.so

# The harvested TeX-string corpus: 3b1b-authored strings are private
# fixtures under the CC BY-NC-SA fixture policy (§15.3). The committed,
# publishable artifacts live in docs/g0/g0-4-corpus/ (hashes + counts +
# construct names, never the strings).
/corpus/

# Look Gallery Reference captures: private fixtures per §15.3 — kept on disk
# and in the capture archive, recorded in docs/look_gallery/CAPTURE_INVENTORY.md,
# never committed.
/gallery/reference_captures/

# Reference-capture residue: manim's Tex runs leave a LaTeX working dir here
# during scripts/capture_reference_imagery.py; never committed.
/latex_cache/

# fm-ntp fuzz harness (ADR-0003): build dir + crash artifacts stay local;
# the corpus and Cargo.lock are committed and governed.
/fuzz/target
/fuzz/artifacts

# Skill-loop / repo-janitor scratch
.skill-loop-progress.md
.skill-loop-progress-*.md

# br doctor per-run artifacts
.doctor/
