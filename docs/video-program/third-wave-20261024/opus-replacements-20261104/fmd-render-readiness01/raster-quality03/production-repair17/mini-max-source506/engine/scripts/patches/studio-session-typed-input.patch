+#[test]
+fn input_discriminant_cannot_be_smuggled_into_an_older_journal_minor() {
+    let mut writer = Writer::new(Schema::new(*b"FMNA", 3, 1, 2));
+    writer.put_u32(1).put_u8(7).put_digest(&sha256(b"input")).put_str("typed input")
+        .put_u8(0).put_u32(0).put_u32(0).put_bool(false).put_digest(&sha256(b"state"))
+        .put_u32(0).put_u32(0);
+    let error = Journal::from_bytes(&writer.finish().unwrap()).unwrap_err();
+    assert!(error.to_string().contains("requires journal minor 1.3"), "{error}");
+}
