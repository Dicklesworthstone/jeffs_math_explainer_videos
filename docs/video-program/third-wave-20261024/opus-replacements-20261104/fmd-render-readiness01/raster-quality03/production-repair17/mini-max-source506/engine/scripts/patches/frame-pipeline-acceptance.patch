+/// Run the same actual native pipeline contract used by installed wheels.
+/// Captured artifacts are returned by value; no interpreter-owned state escapes.
+#[cfg(any(test, feature = "gauntlet"))]
+pub fn run_portal_gauntlet_frame_pipeline() -> Result<(Vec<u8>, Vec<u8>), String> {
+    crate::with_python_test_module("native file frame pipeline", |py, _module, globals| {
+        use pyo3::prelude::*;
+        globals.set_item("__file__", concat!(env!("CARGO_MANIFEST_DIR"), "/tests/frame_pipeline.py"))
+            .map_err(|error| error.to_string())?;
+        let source = std::ffi::CString::new(include_str!("../tests/frame_pipeline.py"))
+            .map_err(|error| error.to_string())?;
+        py.run(source.as_c_str(), Some(globals), Some(globals))
+            .inspect_err(|error| error.print(py))
+            .map_err(|error| error.to_string())?;
+        globals.get_item("_FMN_PIPELINE_EVIDENCE")
+            .map_err(|error| error.to_string())?
+            .ok_or_else(|| "missing native pipeline pixel evidence".to_owned())?
+            .extract().map_err(|error: PyErr| error.to_string())
+    })
+}
