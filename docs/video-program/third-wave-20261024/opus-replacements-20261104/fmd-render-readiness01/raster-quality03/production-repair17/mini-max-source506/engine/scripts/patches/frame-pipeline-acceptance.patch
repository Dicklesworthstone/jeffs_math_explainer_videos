+fn python_frame_pipeline_run(ctx: &mut RunCtx) -> Result<RunOutcome, ScenarioError> {
+    let (first, last) = manimlib::run_portal_gauntlet_frame_pipeline()
+        .map_err(|error| fail(format!("Python native frame pipeline: {error}")))?;
+    let limits = fmn_codec::PngLimits::default();
+    for artifact in [&first, &last] {
+        let decoded = fmn_codec::decode_png(artifact, &limits)
+            .map_err(|error| fail(format!("decode pipeline witness: {error}")))?;
+        if (decoded.width, decoded.height) != (96, 54) {
+            return Err(fail("pipeline lost its frozen viewport"));
+        }
+    }
+    if first == last {
+        return Err(fail("pipeline did not preserve moving capture-time camera/view state"));
+    }
+    ctx.event(LogEvent::new("e2e.python.frame_pipeline")
+        .field("frames_per_run", 12_u64)
+        .field("thread_counts", 3_u64)
+        .field("capture_time_oracle", true)
+        .field("native_gil_release", true));
+    Ok(RunOutcome::ok()
+        .with_counter("pipeline_frames_per_run", 12)
+        .with_counter("pipeline_thread_counts", 3)
+        .with_artifact("pipeline_first.png", first)
+        .with_artifact("pipeline_last.png", last))
+}
