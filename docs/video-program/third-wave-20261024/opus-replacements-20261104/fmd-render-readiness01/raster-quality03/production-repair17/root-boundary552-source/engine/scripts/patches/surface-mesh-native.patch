+    #[test]
+    fn surface_mesh_live_grid_matches_native_surface() {
+        let surface = ParametricSurface::new(|u, v| [u, v, u * v])
+            .resolution(5, 3)
+            .build()
+            .stretched(2.0, 0)
+            .shifted([3.0, -2.0, 0.5]);
+        let live = SurfaceMesh::from_samples(
+            surface.points().to_vec(), surface.unit_normals(), surface.resolution(),
+        ).expect("valid sampled surface")
+            .resolution(4, 2).normal_nudge(0.15).try_build().expect("bounded mesh");
+        let native = SurfaceMesh::new(surface)
+            .resolution(4, 2).normal_nudge(0.15).build();
+        assert_eq!(live, native);
+    }
