+//! Per-document macro preambles over fmd-math's one token expander.
+//!
+//! The validated definition prefix is part of the cache input, but never
+//! part of the consumer's source or span coordinates. Text mode encloses
+//! the prefix in an empty math island: newlines in a preamble must not
+//! become visible prose whitespace. No macro grammar is reimplemented.
+
+use crate::{Mode, TexEngine, TexError, Typeset, TypesetError};
+use fmd_math::{MacroSet, MathError, NodeKind, Span};
+
+/// Maximum UTF-8 bytes in a document's additional macro preamble.
+pub const PREAMBLE_LIMIT_BYTES: usize = 65_536;
+
+pub(crate) fn typeset(
+    engine: &TexEngine,
+    macros: &MacroSet,
+    mode: Mode,
+    source: &str,
+    preamble: &str,
+) -> Result<Typeset, TexError> {
+    if preamble.is_empty() {
+        return engine.typeset(mode, source);
+    }
+    if preamble.len() > PREAMBLE_LIMIT_BYTES {
+        return Err(malformed(format!(
+            "additional_preamble has {} UTF-8 bytes; limit is {PREAMBLE_LIMIT_BYTES}",
+            preamble.len()
+        )));
+    }
+    // Definition parsing, parameter validation, shadowing and recursion
+    // policy remain upstream. A preamble cannot smuggle rendered material
+    // or mode/style declarations into the visible document.
+    let parsed = fmd_math::parse_with_macros(preamble, macros)?;
+    if !matches!(&parsed.kind, NodeKind::List(items) if items.is_empty()) {
+        return Err(malformed(
+            "additional_preamble must contain only native macro definitions, comments and whitespace"
+                .to_owned(),
+        ));
+    }
+    let (open, close) = match mode {
+        Mode::Math(_) => ("", "\n"),
+        Mode::Text => ("$", "\n$"),
+    };
+    let prefix = preamble.len().checked_add(open.len() + close.len()).ok_or(
+        TypesetError::SizeOverflow { context: "preamble prefix" },
+    )?;
+    let size = prefix.checked_add(source.len()).ok_or(TypesetError::SizeOverflow {
+        context: "preamble and source",
+    })?;
+    // Reuse the typeset document's resource ceiling before creating an
+    // additional owned copy; a rejected request never warms the cache.
+    if size > crate::TYPESET_DOCUMENT_LIMIT_BYTES {
+        return Err(TypesetError::DocumentTooLarge {
+            bytes: size,
+            limit: crate::TYPESET_DOCUMENT_LIMIT_BYTES,
+        }.into());
+    }
+    let mut input = String::new();
+    input.try_reserve_exact(size).map_err(|error| TypesetError::AllocationFailed {
+        context: "preamble and source bytes", requested: size, error,
+    })?;
+    input.push_str(open);
+    input.push_str(preamble);
+    // A newline terminates a final comment instead of commenting out the
+    // formula (or the closing math island in text mode).
+    input.push_str(close);
+    input.push_str(source);
+    let mut layout = engine.typeset(mode, &input)?.layout;
+    for span in layout.glyphs.iter_mut().map(|p| &mut p.span)
+        .chain(layout.rules.iter_mut().map(|p| &mut p.span))
+        .chain(layout.paths.iter_mut().map(|p| &mut p.span))
+    {
+        rebase(span, prefix, size)?;
+    }
+    let mut original = String::new();
+    original.try_reserve_exact(source.len()).map_err(|error| TypesetError::AllocationFailed {
+        context: "original Tex source bytes", requested: source.len(), error,
+    })?;
+    original.push_str(source);
+    Ok(Typeset::new(original, layout)?)
+}
+
+fn malformed(what: String) -> TexError {
+    TexError::Math(MathError::Malformed { what, at: 0 })
+}
+
+fn rebase(span: &mut Span, prefix: usize, end: usize) -> Result<(), TexError> {
+    if span.start < prefix || span.end < span.start || span.end > end {
+        return Err(TypesetError::NonCanonical {
+            field: "preamble output span",
+            reason: "macro expansion retained a definition-site span; nested macro calls in definition bodies require an upstream fmd-math fix",
+        }.into());
+    }
+    span.start -= prefix;
+    span.end -= prefix;
+    Ok(())
+}
