+//! Native preambles must change semantics/cache identity, never source identity.
+use fmn_tex::{Layout, Mode, PREAMBLE_LIMIT_BYTES, Span, Style, TexEngine, Typeset};
+
+const HALF: &str = r"\newcommand{\half}[1]{\frac{#1}{2}}";
+
+fn engine(pack: &'static str) -> TexEngine {
+    TexEngine::new(pack, None).expect("bundled engine")
+}
+
+fn geometry(mut layout: Layout) -> Layout {
+    for span in layout.glyphs.iter_mut().map(|p| &mut p.span)
+        .chain(layout.rules.iter_mut().map(|p| &mut p.span))
+        .chain(layout.paths.iter_mut().map(|p| &mut p.span))
+    {
+        *span = Span::new(0, 0);
+    }
+    layout
+}
+
+#[test]
+fn empty_preamble_preserves_canonical_documents() {
+    let e = engine("fmd-math/pack/default");
+    for (mode, src) in [(Mode::Math(Style::Text), r"\frac{x}{2}"), (Mode::Text, "a $x$ b")] {
+        assert_eq!(e.typeset(mode, src).unwrap().to_bytes().unwrap(),
+            e.typeset_with_preamble(mode, src, "").unwrap().to_bytes().unwrap());
+    }
+}
+
+#[test]
+fn preamble_geometry_matches_independent_expansions_in_every_style() {
+    let e = engine("fmd-math/pack/default");
+    let preamble = format!("{HALF}\n{}", r"\newcommand{\outer}[1]{\left(\sqrt{#1}\right)}");
+    for style in [Style::Display, Style::Text, Style::Script, Style::ScriptScript] {
+        let mode = Mode::Math(style);
+        let actual = e.typeset_with_preamble(mode, r"\outer{\half{x}}", &preamble).unwrap();
+        let expected = e.typeset(mode, r"\left(\sqrt{\frac{x}{2}}\right)").unwrap();
+        assert_eq!(geometry(actual.layout), geometry(expected.layout));
+    }
+}
+
+#[test]
+fn preamble_whitespace_and_trailing_comments_are_invisible_in_text_mode() {
+    let e = engine("fmd-math/pack/default");
+    let preamble = format!("\n% λ UTF-8 comment\n{HALF}\n% comment without a final newline");
+    for (src, expanded) in [
+        (r"half: $\half{x}$", r"half: $\frac{x}{2}$"),
+        (r"$\half{x}$", r"$\frac{x}{2}$"),
+        (r"$$\half{x}$$", r"$$\frac{x}{2}$$"),
+        (r"\half{x}", r"\frac{x}{2}"),
+    ] {
+        let t = e.typeset_with_preamble(Mode::Text, src, &preamble).unwrap();
+        assert_eq!(t.source, src);
+        assert_eq!(geometry(t.layout), geometry(e.typeset(Mode::Text, expanded).unwrap().layout));
+    }
+}
+
+#[test]
+fn preamble_spans_refer_to_original_utf8_source_and_arguments() {
+    let e = engine("fmd-math/pack/default");
+    let source = r"λ+\half{x}+\half{y}";
+    let t = e.typeset_with_preamble(Mode::Math(Style::Text), source, HALF).unwrap();
+    assert_eq!(t.source, source);
+    for sub in &t.subs {
+        assert!(sub.span.start <= sub.span.end && sub.span.end <= source.len());
+        assert!(source.is_char_boundary(sub.span.start) && source.is_char_boundary(sub.span.end));
+    }
+    assert_eq!(t.occurrences("x")[0].len(), 1);
+    assert_eq!(t.occurrences("y")[0].len(), 1);
+    let first = &t.occurrences(r"\half{x}")[0];
+    let second = &t.occurrences(r"\half{y}")[0];
+    assert!(first.len() >= 3 && second.len() >= 3);
+    assert!(first.iter().all(|id| !second.contains(id)));
+    assert_eq!(Typeset::from_bytes(&t.to_bytes().unwrap()).unwrap().subs, t.subs);
+}
+
+#[test]
+fn preamble_cache_is_content_sensitive_and_does_not_leak_definitions() {
+    use fmn_cache::{Store, StoreConfig};
+    use fmn_platform::{clock::FakeClock, fs::VirtualFs};
+    use std::sync::Arc;
+    let root = if cfg!(windows) { r"C:\preamble-cache" } else { "/preamble-cache" };
+    let store = Store::open(Arc::new(VirtualFs::new()), Arc::new(FakeClock::new()), root,
+        StoreConfig::default()).unwrap();
+    let e = engine("fmd-math/pack/default").with_cache(&store).unwrap();
+    let mode = Mode::Math(Style::Text);
+    let a = r"\newcommand{\value}{x}";
+    let b = r"\newcommand{\value}{y}";
+    let first = e.typeset_with_preamble(mode, r"\value", a).unwrap();
+    let other = e.typeset_with_preamble(mode, r"\value", b).unwrap();
+    assert_ne!(first.layout.glyphs[0].gid, other.layout.glyphs[0].gid);
+    let warm = e.typeset_with_preamble(mode, r"\value", a).unwrap();
+    assert_eq!(first.to_bytes().unwrap(), warm.to_bytes().unwrap());
+    assert!(e.typeset(mode, r"\value").is_err());
+}
+
+#[test]
+fn preamble_renewal_respects_selected_pack_and_source_layering() {
+    let mode = Mode::Math(Style::Text);
+    let default = engine("fmd-math/pack/default");
+    let empty = engine("fmd-math/pack/empty");
+    let renew = r"\renewcommand{\minus}{+}";
+    let t = default.typeset_with_preamble(mode, r"a\minus b", renew).unwrap();
+    assert_eq!(geometry(t.layout), geometry(default.typeset(mode, "a+b").unwrap().layout));
+    assert!(empty.typeset_with_preamble(mode, "x", renew).is_err());
+    let t = default.typeset_with_preamble(mode,
+        r"\renewcommand{\half}[1]{\sqrt{#1}}\half{x}", HALF).unwrap();
+    assert_eq!(geometry(t.layout), geometry(default.typeset(mode, r"\sqrt{x}").unwrap().layout));
+    assert!(default.typeset_with_preamble(mode, r"\newcommand{\half}{x}", HALF).is_err());
+}
+
+#[test]
+fn preamble_errors_are_bounded_and_never_silently_rendered() {
+    let e = engine("fmd-math/pack/default");
+    let mode = Mode::Math(Style::Text);
+    for preamble in ["visible", r"\quad", r"\displaystyle", r"\usepackage{amsmath}",
+        r"\input{secret}", r"\newcommand{\bad}[1]{#2}", r"\newcommand{\bad}{unclosed",
+        r"\newcommand{\same}{a}\newcommand{\same}{b}", r"\renewcommand{\absent}{x}"] {
+        assert!(e.typeset_with_preamble(mode, "x", preamble).is_err(), "{preamble}");
+    }
+    let oversized = " ".repeat(PREAMBLE_LIMIT_BYTES + 1);
+    assert!(e.typeset_with_preamble(mode, "x", &oversized).unwrap_err().to_string().contains("limit"));
+    assert!(e.typeset_with_preamble(mode, r"\loop", r"\newcommand{\loop}{\loop}").is_err());
+    assert!(e.typeset_with_preamble(mode, r"\half{x}", HALF).is_ok());
+}
+
+#[test]
+fn preamble_whitespace_only_preserves_empty_and_nonempty_documents() {
+    let e = engine("fmd-math/pack/default");
+    for mode in [Mode::Math(Style::Text), Mode::Text] {
+        for src in ["", "x"] {
+            let t = e.typeset_with_preamble(mode, src, " \n% comment").unwrap();
+            assert_eq!(t.to_bytes().unwrap(), e.typeset(mode, src).unwrap().to_bytes().unwrap());
+        }
+    }
+}
+
+
+#[test]
+fn preamble_definition_site_spans_are_refused_instead_of_publishing_wrong_geometry() {
+    let e = engine("fmd-math/pack/default");
+    let preamble = format!("{HALF}\n{}", r"\newcommand{\outer}[1]{\half{#1}}");
+    let error = e.typeset_with_preamble(Mode::Math(Style::Text), r"\outer{x}", &preamble)
+        .expect_err("the pinned upstream expander retains definition-site spans");
+    assert!(error.to_string().contains("definition-site span"), "{error}");
+}
