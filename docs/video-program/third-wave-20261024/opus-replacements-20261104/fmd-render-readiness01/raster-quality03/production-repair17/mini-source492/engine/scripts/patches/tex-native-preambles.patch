+//! Native library consumers share the same document-local Scribe path.
+use fmn_core::constants::{RED, BLUE};
+use fmn_library::{Tex, TexText, TexEngine};
+
+#[test]
+fn tex_preambles_color_native_children_by_original_source() {
+    let engine = TexEngine::new("fmd-math/pack/default", None).unwrap();
+    let colors = [(r"\half{x}", RED), ("y", BLUE)];
+    let built = Tex::new(r"\half{x}+y")
+        .additional_preamble(r"\newcommand{\half}[1]{\frac{#1}{2}}")
+        .t2c(&colors).build(&engine).unwrap();
+    for id in &built.occurrences(r"\half{x}")[0] {
+        assert_eq!(built.vmob.children()[*id].style().fill_color, RED);
+    }
+    for id in &built.occurrences("y")[0] {
+        assert_eq!(built.vmob.children()[*id].style().fill_color, BLUE);
+    }
+    assert_eq!(built.span_map().source.as_ref(), r"\half{x}+y");
+}
+
+#[test]
+fn tex_preambles_work_in_library_text_and_named_pack_engines() {
+    for pack in ["fmd-math/pack/default", "fmd-math/pack/basic", "fmd-math/pack/empty"] {
+        let engine = TexEngine::new(pack, None).unwrap();
+        let built = TexText::new(r"half: $\half{x}$")
+            .additional_preamble(r"\newcommand{\half}[1]{\frac{#1}{2}}")
+            .build(&engine).unwrap();
+        assert!(!built.is_empty());
+        assert_eq!(built.typeset.source, r"half: $\half{x}$");
+        assert_eq!(built.occurrences("x")[0].len(), 1);
+    }
+}
