--- /dev/null
+++ b/crates/fmn-python/src/portal_tex.rs
@@ -0,0 +1,41 @@
+//! Named native Tex templates. The registry admits only its finite built-in
+//! pack set; each engine (including bundled-face parsing) is created once
+//! per thread. Per-document preambles never mutate these shared engines.
+
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+
+use fmn_library::TexEngine;
+use pyo3::PyResult;
+use pyo3::exceptions::PyRuntimeError;
+
+thread_local! {
+    static ENGINES: RefCell<BTreeMap<&'static str, TexEngine>> = const {
+        RefCell::new(BTreeMap::new())
+    };
+}
+
+pub(super) fn with_template<T>(
+    template: &str,
+    operation: impl FnOnce(&TexEngine) -> PyResult<T>,
+) -> PyResult<T> {
+    let name = if template.is_empty() { "default" } else { template };
+    let pack = fmn_config::PackRegistry::builtin()
+        .resolve_template(name)
+        .map_err(super::tex_error)?;
+    if pack.name == "default" {
+        return super::with_tex_engine(operation);
+    }
+    ENGINES.with(|cell| {
+        let mut engines = cell.try_borrow_mut().map_err(|_| {
+            PyRuntimeError::new_err("native Tex template engine is already borrowed")
+        })?;
+        if let std::collections::btree_map::Entry::Vacant(entry) = engines.entry(pack.content_id) {
+            entry.insert(TexEngine::new(pack.content_id, None).map_err(super::tex_error)?);
+        }
+        let engine = engines.get(pack.content_id).ok_or_else(|| {
+            PyRuntimeError::new_err("native Tex template engine was not installed")
+        })?;
+        operation(engine)
+    })
+}
