new file mode 100644
--- /dev/null
+++ b/crates/fmn-python/tests/tex_preambles.py
@@ -0,0 +1,156 @@
+"""Native per-document preambles: original source spans and independent pixels.
+
+Run against an installed wheel with ``python -I tex_preambles.py``.
+"""
+from pathlib import Path
+import tempfile
+
+import numpy as np
+import manimlib as m
+from manimlib.mobject.svg.old_tex_mobject import OldTex, OldTexText, SingleStringTex
+
+HALF = r"\newcommand{\half}[1]{\frac{#1}{2}}"
+PAIR = r"\newcommand{\pair}[2]{\left(\frac{#1}{#2}\right)}"
+
+
+def _same_geometry(actual, expected):
+    a, b = actual.get_all_points(), expected.get_all_points()
+    assert a.shape == b.shape, (a.shape, b.shape)
+    assert np.array_equal(a, b), "native macro expansion changed the independent geometry"
+
+
+def _refuses(make, contains=None, exception=Exception):
+    try:
+        make()
+    except exception as error:
+        if contains is not None:
+            assert contains.lower() in str(error).lower(), str(error)
+        return
+    raise AssertionError("invalid preamble/template was accepted")
+
+
+def verify_tex_preambles():
+    # The same native builder serves all five modern/legacy constructors.
+    for cls in (m.Tex, OldTex, SingleStringTex):
+        for template in ("", "default", "basic", "empty"):
+            actual = cls(r"\half{x}", template=template, additional_preamble=HALF)
+            _same_geometry(actual, cls(r"\frac{x}{2}", template=template))
+            assert actual.additional_preamble == HALF and actual.template == template
+    for cls in (m.TexText, OldTexText):
+        for source, expanded in ((r"half: $\half{x}$", r"half: $\frac{x}{2}$"),
+                                 (r"$\half{x}$", r"$\frac{x}{2}$"),
+                                 (r"$$\half{x}$$", r"$$\frac{x}{2}$$")):
+            prefix = "\n% λ UTF-8 comment\n" + HALF + "\n% no final newline"
+            _same_geometry(cls(source, additional_preamble=prefix), cls(expanded))
+    _same_geometry(SingleStringTex(r"half: $\half{x}$", math_mode=False,
+        additional_preamble=HALF), SingleStringTex(r"half: $\frac{x}{2}$", math_mode=False))
+
+    # Nested macros, multiple arguments and drawn delimiters use upstream
+    # expansion rather than a second Python implementation.
+    prefix = HALF + "\n" + PAIR
+    _same_geometry(m.Tex(r"\pair{\half{x}}{\sqrt{y}}", additional_preamble=prefix),
+                   m.Tex(r"\left(\frac{\frac{x}{2}}{\sqrt{y}}\right)"))
+    _same_geometry(m.Tex(r"a\minus b", additional_preamble=r"\renewcommand{\minus}{+}"),
+                   m.Tex("a+b"))
+    _same_geometry(m.Tex(r"\renewcommand{\half}[1]{\sqrt{#1}}\half{x}",
+                        additional_preamble=HALF), m.Tex(r"\sqrt{x}"))
+
+    # Selection coordinates exclude the preamble even after UTF-8 text.
+    source = r"λ+\half{x}+\half{y}"
+    actual = m.Tex(source, additional_preamble=HALF,
+                   isolate=[r"\half{x}", r"\half{y}"],
+                   t2c={r"\half{x}": m.RED, r"\half{y}": m.BLUE})
+    assert actual.get_tex() == source and actual.string == source
+    for start, end in actual._string_sub_spans:
+        assert 0 <= start <= end <= len(source.encode())
+        source.encode()[:start].decode()
+        source.encode()[:end].decode()
+    red = actual.get_part_by_tex(r"\half{x}")
+    blue = actual.get_part_by_tex(r"\half{y}")
+    assert red is not blue
+    assert all(part.get_fill_color() == m.RED for part in red.family_members_with_points())
+    assert all(part.get_fill_color() == m.BLUE for part in blue.family_members_with_points())
+    assert len(actual.get_parts_by_tex("x")) == 1
+    multi = m.Tex(r"\half{x}", "+", r"\half{y}", additional_preamble=HALF)
+    _same_geometry(multi, m.Tex(r"\frac{x}{2}", "+", r"\frac{y}{2}"))
+    assert len(multi) == 3
+    clone = multi.copy()
+    _same_geometry(clone, multi)
+    assert clone.additional_preamble == HALF
+    before = multi.get_all_points().copy()
+    clone.shift(m.RIGHT)
+    assert np.array_equal(multi.get_all_points(), before)
+
+    # A cached engine must never retain a previous document's macro table.
+    for symbol in ("x", "y", "x", "z"):
+        _same_geometry(m.Tex(r"\value", additional_preamble=r"\newcommand{\value}{" + symbol + "}"),
+                       m.Tex(symbol))
+    _refuses(lambda: m.Tex(r"\value"), "value")
+    _refuses(lambda: m.Tex(r"\minus", template="empty"), "minus")
+    _refuses(lambda: m.Tex("x", template="basic", additional_preamble=r"\renewcommand{\minus}{+}"), "minus")
+    _refuses(lambda: m.Tex("x", template="does-not-exist"), "available packs")
+    _refuses(lambda: m.Tex("x", template="ctex"), "CJK")
+    _refuses(lambda: m.Tex("x", template="comic_sans"), "bundled")
+    for invalid in (None, {}, 12):
+        _refuses(lambda invalid=invalid: m.Tex("x", template=invalid), exception=TypeError)
+        _refuses(lambda invalid=invalid: SingleStringTex("x", additional_preamble=invalid), exception=TypeError)
+    for bad in ("visible", r"\quad", r"\displaystyle", r"\usepackage{amsmath}",
+                r"\input{secret}", r"\newcommand{\bad}[1]{#2}",
+                r"\newcommand{\bad}{unclosed", r"\newcommand{\bad}{a}\newcommand{\bad}{b}"):
+        _refuses(lambda bad=bad: m.Tex("x", additional_preamble=bad))
+    _refuses(lambda: m.Tex("x", additional_preamble=" " * 65537), "limit")
+    _refuses(lambda: m.Tex(r"\loop", additional_preamble=r"\newcommand{\loop}{\loop}"), "recurs")
+    _refuses(lambda: m.Tex(r"\outer{x}", additional_preamble=HALF +
+        r"\newcommand{\outer}[1]{\half{#1}}"), "definition-site span")
+    _same_geometry(m.Tex(r"\half{x}", additional_preamble=HALF), m.Tex(r"\frac{x}{2}"))
+    for cls in (m.Tex, m.TexText):
+        _same_geometry(cls("x", additional_preamble="\n% only a comment"), cls("x"))
+        _same_geometry(cls("x", additional_preamble=""), cls("x"))
+    return 10
+
+
+def render_tex_preambles(destination, seed=0):
+    checks = verify_tex_preambles()
+
+    class PreambleScene(m.Scene):
+        reference = False
+        random_seed = seed & 0xFFFF_FFFF
+
+        def construct(self):
+            if self.reference:
+                formula = m.Tex(r"\left(\frac{x}{\sqrt{y}}\right)", color=m.RED)
+                caption = m.TexText(r"half: $\frac{x}{2}$", color=m.BLUE)
+            else:
+                formula = m.Tex(r"\pair{x}{\sqrt{y}}", additional_preamble=PAIR, color=m.RED)
+                caption = m.TexText(r"half: $\half{x}$", additional_preamble=HALF, color=m.BLUE)
+            formula.scale(2).shift(m.UP)
+            caption.scale(2).shift(m.DOWN)
+            self.add(formula, caption)
+
+    destination = Path(destination)
+    destination.mkdir(parents=True, exist_ok=True)
+    images = []
+    for name, reference, threads in (("preamble-1.png", False, 1),
+                                     ("preamble-4.png", False, 4),
+                                     ("expanded.png", True, 1)):
+        scene = PreambleScene()
+        scene.reference = reference
+        path = destination / name
+        scene._begin_png(str(path), 192, 128, 30, threads, seed)
+        try:
+            scene.run()
+            scene._finish_render(scene.frame._core, scene.camera.light_source.get_center())
+        except BaseException:
+            scene._abort_render()
+            raise
+        images.append(path.read_bytes())
+    assert images[0] == images[1], "thread count changed native macro output"
+    assert images[0] == images[2], "native preambles differ from independently expanded formulas"
+    assert images[0][:8] == b"\x89PNG\r\n\x1a\n"
+    return images[0], checks
+
+
+if __name__ == "__main__":
+    with tempfile.TemporaryDirectory(prefix="fmn-tex-preambles-") as directory:
+        png, checks = render_tex_preambles(directory)
+    print(f"Tex preambles: {checks} acceptance groups; identical native 1/4-thread and independent PNGs ({len(png)} bytes)")
diff --git a/docs/behavior_notes/BN-05-native-text-typesetting.md b/docs/behavior_notes/BN-05-native-text-typesetting.md
--- a/docs/behavior_notes/BN-05-native-text-typesetting.md
+++ b/docs/behavior_notes/BN-05-native-text-typesetting.md
@@ -51,3 +51,43 @@
 - Pango-only markup (arbitrary attributes, `<gravity>`, etc.) is out of
   the compatibility claim; the supported set is documented in
   `fmn_text::markup`.
+
+
+## Document-local TeX preambles and named native templates
+
+`Tex`, `TexText`, `OldTex`, `OldTexText`, and `SingleStringTex` accept
+`template="default"`, `"basic"`, or `"empty"`; `""` selects `default`.
+The names resolve through the same native preamble-pack registry as Rust
+configuration. Host-font and CJK templates retain their named capability
+refusals; they do not invoke LaTeX or silently substitute a different pack.
+
+`additional_preamble` accepts native `\newcommand` and `\renewcommand`
+definitions, comments and whitespace. Expansion is performed by fmd-math,
+with its existing recursion/depth/token budgets. A preamble is limited to
+65,536 UTF-8 bytes. Package loading, external-file directives and visible
+material are refused rather than ignored. These are native macro definitions,
+not an arbitrary LaTeX document preamble.
+
+```python
+formula = Tex(r"\half{x}", additional_preamble=r"\newcommand{\half}[1]{\frac{#1}{2}}")
+caption = TexText(r"Half: $\half{x}$", additional_preamble=formula.additional_preamble)
+```
+
+Definitions are local to the constructed document. They cannot leak into
+another object through a reused engine or cache. Cache identity includes
+the entire preamble and selected pack; changing a macro re-typesets.
+`get_tex()`, `isolate`, color maps and matching continue to use the original
+formula's source spans, including UTF-8 byte coordinates. Preamble comments
+and newlines add no visible whitespace to `TexText`.
+
+Rust consumers use `Tex::additional_preamble`,
+`TexText::additional_preamble`, or `TexEngine::typeset_with_preamble` with
+the same semantics and the same native parser.
+
+The pinned fmd-math expander has a known defect for macro calls nested in
+another macro's **definition body**: it may keep definition-site spans and
+fail to substitute the enclosing parameters. This route detects those
+invalid spans and returns a named error rather than publishing wrong
+geometry. Nested calls in **arguments** (for example,
+`\pair{\half{x}}{y}`) are supported. Until the upstream defect is corrected,
+write native primitives directly in definition bodies.
