+/// A native mathematical list can fail in its plain-text label or its
+/// TexText content. Both preserve the underlying named error.
+#[derive(Debug)]
+pub enum SpecialTexError {
+    /// Bundled bullet/number label layout failed.
+    Label(TextMobjectError),
+    /// Native text/math content failed.
+    Content(TexMobjectError),
+}
+
+impl core::fmt::Display for SpecialTexError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::Label(error) => error.fmt(f),
+            Self::Content(error) => error.fmt(f),
+        }
+    }
+}
+
+impl std::error::Error for SpecialTexError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Label(error) => Some(error),
+            Self::Content(error) => Some(error),
+        }
+    }
+}
+
+impl From<TextMobjectError> for SpecialTexError {
+    fn from(error: TextMobjectError) -> Self { Self::Label(error) }
+}
+
+impl From<TexMobjectError> for SpecialTexError {
+    fn from(error: TexMobjectError) -> Self { Self::Content(error) }
+}
 
