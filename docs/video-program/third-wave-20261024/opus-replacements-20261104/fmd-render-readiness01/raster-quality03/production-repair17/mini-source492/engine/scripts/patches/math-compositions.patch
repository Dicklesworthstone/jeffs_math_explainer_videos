new file mode 100644
--- /dev/null
+++ b/crates/fmn-library/tests/math_compositions.rs
@@ -0,0 +1,109 @@
+//! Native mathematical titles and lists retain their composition semantics.
+use fmn_core::constants::{FRAME_Y_RADIUS, MED_SMALL_BUFF, RED};
+use fmn_library::{BulletedList, Title, TexText, TexEngine, VMobject};
+use fmn_text::FontBook;
+
+const HALF: &str = r"\newcommand{\half}[1]{\frac{#1}{2}}";
+
+fn engine() -> TexEngine {
+    TexEngine::new("fmd-math/pack/default", None).unwrap()
+}
+
+fn primitive_count(value: &VMobject) -> usize {
+    usize::from(!value.path().unwrap().is_empty()) + value.children().iter().map(primitive_count).sum::<usize>()
+}
+
+#[test]
+fn math_title_content_is_real_textext_not_literal_source() {
+    let e = engine();
+    let actual = Title::new(&[r"Half: $\half{x}$"]).build_tex(&e, HALF).unwrap();
+    let expected = TexText::new(r"Half: $\frac{x}{2}$").font_size(72.0).build(&e).unwrap();
+    let content = &actual.vmob.children()[0];
+    assert_eq!(primitive_count(content), primitive_count(&expected.vmob));
+    assert!((content.length_over_dim(0) - expected.vmob.length_over_dim(0)).abs() < 1e-9);
+    assert!((content.extent().unwrap().1[1] - (FRAME_Y_RADIUS - MED_SMALL_BUFF)).abs() < 1e-9);
+    assert!(actual.underline().is_some());
+}
+
+#[test]
+fn math_title_part_provenance_preserves_every_primitive_once() {
+    let e = engine();
+    // The fraction spans a part boundary. Its rule belongs to the part
+    // containing the command, while the denominator belongs to the next.
+    let parts = [r"λ $\frac{x}", r"{y}$ end"];
+    let title = Title::new(&parts).build_tex(&e, "").unwrap();
+    let source = parts.join(" ");
+    let expected = TexText::new(&source).font_size(72.0).build(&e).unwrap();
+    assert_eq!(title.tex_paths().len(), expected.len());
+    assert_eq!(title.tex_spans().len(), expected.len());
+    let unique: std::collections::BTreeSet<_> = title.tex_paths().iter().collect();
+    assert_eq!(unique.len(), expected.len());
+    for (path, &(start, end)) in title.tex_paths().iter().zip(title.tex_spans()) {
+        assert_eq!(path.len(), 2);
+        assert!(path[0] < parts.len());
+        assert!(source.is_char_boundary(start) && source.is_char_boundary(end));
+        assert!(end <= source.len());
+        assert!(!title.vmob.children()[path[0]].children()[path[1]].path().unwrap().is_empty());
+    }
+    assert_eq!(primitive_count(&title.vmob), primitive_count(&expected.vmob) + 1);
+}
+
+#[test]
+fn math_title_underline_configuration_and_empty_titles_remain_valid() {
+    let e = engine();
+    let title = Title::new(&[r"$x^2$"]).match_underline_width_to_text(true)
+        .underline_style(fmn_library::special_tex::default_underline_style().stroke(RED, 3.0, 1.0))
+        .build_tex(&e, "").unwrap();
+    let line = title.underline().unwrap();
+    assert!((line.length_over_dim(0) - title.vmob.children()[0].length_over_dim(0)).abs() < 1e-9);
+    assert_eq!(line.style().stroke_color, RED);
+    for parts in [vec![], vec![""], vec!["", ""]] {
+        let title = Title::new(&parts).include_underline(false).build_tex(&e, HALF).unwrap();
+        assert!(title.underline().is_none());
+        assert_eq!(title.vmob.children().len(), parts.len());
+        assert!(title.tex_paths().is_empty());
+    }
+}
+
+#[test]
+fn math_list_content_uses_textext_and_plain_labels_keep_their_identity() {
+    let e = engine();
+    let book = FontBook::bundled().unwrap();
+    let items = [r"Half: $\half{x}$", r"Root: $\sqrt{y}$"];
+    for numbered in [false, true] {
+        let actual = BulletedList::new(&items).numbered(numbered).build_tex(&book, &e, HALF).unwrap();
+        let literal = BulletedList::new(&items).numbered(numbered).build(&book).unwrap();
+        assert_eq!(actual.vmob.children().len(), 2);
+        for (index, item) in items.iter().enumerate() {
+            let row = &actual.vmob.children()[index];
+            let expected = TexText::new(item).additional_preamble(HALF).build(&e).unwrap();
+            assert_eq!(row.children().len(), 2);
+            assert_eq!(primitive_count(&row.children()[1]), primitive_count(&expected.vmob));
+            assert_eq!(primitive_count(&row.children()[0]), primitive_count(&literal.vmob.children()[index].children()[0]));
+            assert!(row.children()[0].extent().unwrap().1[0] < row.children()[1].extent().unwrap().0[0]);
+        }
+        assert!(actual.vmob.children()[0].extent().unwrap().0[1] > actual.vmob.children()[1].extent().unwrap().1[1]);
+    }
+}
+
+#[test]
+fn mathematical_lists_preserve_fade_and_empty_list_behavior() {
+    let e = engine();
+    let book = FontBook::bundled().unwrap();
+    let items = [r"$\half{x}$", r"$\half{y}$"];
+    let list = BulletedList::new(&items).fade_all_but(1).build_tex(&book, &e, HALF).unwrap();
+    assert_eq!(list.vmob.children()[0].style().fill_opacity, 0.25);
+    assert_eq!(list.vmob.children()[1].style().fill_opacity, 1.0);
+    assert!(BulletedList::new(&[]).build_tex(&book, &e, HALF).unwrap().vmob.children().is_empty());
+}
+
+#[test]
+fn mathematical_composition_errors_do_not_leak_definitions() {
+    let e = engine();
+    let book = FontBook::bundled().unwrap();
+    assert!(Title::new(&[r"$\unknown{x}$"]).build_tex(&e, "").is_err());
+    assert!(BulletedList::new(&[]).build_tex(&book, &e, "visible preamble").is_err());
+    let items = [r"$\newcommand{\local}{x}\local$", r"$\local$"];
+    assert!(BulletedList::new(&items).build_tex(&book, &e, "").is_err());
+    assert!(Title::new(&[r"$\half{x}$"]).build_tex(&e, HALF).is_ok());
+}
