--- /dev/null
+++ b/crates/fmn-python/tests/math_compositions.py
@@ -0,0 +1,140 @@
+"""Real mathematics in composed titles and bullet lists, not literal TeX."""
+from pathlib import Path
+import tempfile
+import numpy as np
+import manimlib as m
+
+HALF = r"\newcommand{\half}[1]{\frac{#1}{2}}"
+
+
+def same_shape(actual, expected):
+    a = actual.get_all_points().astype(float)
+    b = expected.get_all_points().astype(float)
+    assert a.shape == b.shape, (a.shape, b.shape)
+    if len(a):
+        # Placement happens in native f64 before record storage rounds to
+        # f32. Compare translation-independent shapes at that precision.
+        a -= (a.min(axis=0) + a.max(axis=0)) / 2
+        b -= (b.min(axis=0) + b.max(axis=0)) / 2
+        assert np.allclose(a, b, atol=2e-6, rtol=0)
+
+
+def refuses(call, contains):
+    try:
+        call()
+    except Exception as error:
+        assert contains.lower() in str(error).lower(), str(error)
+        return
+    raise AssertionError("invalid mathematical content was silently accepted")
+
+
+def verify_math_compositions():
+    for template in ("", "default", "basic", "empty"):
+        title = m.Title(r"Half: $\half{x}$", template=template, additional_preamble=HALF)
+        same_shape(title[0], m.TexText(r"Half: $\frac{x}{2}$", font_size=72))
+        assert title.template == template and title.additional_preamble == HALF
+        assert title.get_tex() == r"Half: $\half{x}$"
+        assert np.isclose(title[0].get_top()[1], m.FRAME_Y_RADIUS - m.MED_SMALL_BUFF)
+        assert title.underline is title[-1]
+    title = m.Title(r"λ $\frac{x}", r"{y}$ end", color=m.BLUE,
+                    match_underline_width_to_text=True,
+                    underline_style=dict(stroke_color=m.RED, stroke_width=3))
+    reference = m.TexText(r"λ $\frac{x} {y}$ end", font_size=72)
+    same_shape(m.VGroup(*title[:-1]), reference)
+    assert len(title) == 3
+    assert len(title._string_sub_spans) == len(reference._string_sub_spans)
+    assert all(path[0] < 2 for path in title._string_sub_paths)
+    assert len({tuple(path) for path in title._string_sub_paths}) == len(title._string_sub_paths)
+    numerator = title.get_part_by_tex("x")
+    assert len(numerator.family_members_with_points()) == 1
+    numerator.set_fill(m.GREEN)
+    assert title.underline.get_stroke_color() == m.RED
+    assert title.underline.get_stroke_width() == 3
+    assert np.isclose(title.underline.get_width(), m.VGroup(*title[:-1]).get_width())
+    copy = title.copy()
+    before = title.get_all_points().copy()
+    copy.shift(m.RIGHT)
+    assert np.array_equal(title.get_all_points(), before)
+    assert len(copy.get_part_by_tex("y").family_members_with_points()) == 1
+    for parts in ((), ("",), ("", "")):
+        title = m.Title(*parts, include_underline=False, additional_preamble=HALF)
+        assert len(title) == len(parts) and not hasattr(title, "underline")
+        assert title._string_sub_paths == []
+    items = (r"Half: $\half{x}$", r"Root: $\sqrt{y}$", r"Area: $\pi r^2$")
+    for numbered in (False, True):
+        listing = m.BulletedList(*items, numbered=numbered, buff=0.4,
+                                 template="basic", additional_preamble=HALF, color=m.BLUE)
+        assert len(listing) == len(items)
+        lefts = []
+        for i, (row, source) in enumerate(zip(listing, items)):
+            assert len(row) == 2
+            same_shape(row[1], m.TexText(source, additional_preamble=HALF))
+            same_shape(row[0], m.Text(str(i + 1) + "." if numbered else "•"))
+            assert row[0].get_right()[0] < row[1].get_left()[0]
+            lefts.append(row.get_left()[0])
+        assert np.allclose(lefts, lefts[0], atol=2e-6)
+        identities = list(listing)
+        listing.fade_all_but(1)
+        assert all(a is b for a, b in zip(identities, listing))
+        assert listing[0][1].get_fill_opacity() == 0.25
+        assert listing[1][1].get_fill_opacity() == 1.0
+    assert len(m.BulletedList(additional_preamble=HALF)) == 0
+    for cls in (m.Title, m.BulletedList):
+        refuses(lambda cls=cls: cls(r"$\unknown{x}$"), "unknown")
+        refuses(lambda cls=cls: cls("x", template="no-such-pack"), "available packs")
+        refuses(lambda cls=cls: cls("x", additional_preamble="visible"), "preamble")
+        refuses(lambda cls=cls: cls("x", additional_preamble=None), "strings")
+        refuses(lambda cls=cls: cls("x", additional_preamble=" " * 65537), "limit")
+    refuses(lambda: m.BulletedList(r"$\newcommand{\local}{x}\local$", r"$\local$"), "local")
+    # Native source spans also survive the animation lifecycle.
+    source = m.Tex(r"\half{x}", additional_preamble=HALF, isolate=["x"])
+    target = m.Tex(r"\half{y}", additional_preamble=HALF, isolate=["y"])
+    scene = m.Scene()
+    scene.add(source)
+    scene.play(m.TransformMatchingTex(source, target, run_time=2 / 30))
+    assert target in scene.mobjects and source not in scene.mobjects
+    same_shape(target, m.Tex(r"\frac{y}{2}"))
+    return 8
+
+
+def render_math_compositions(destination, seed=0):
+    checks = verify_math_compositions()
+
+    class MathScene(m.Scene):
+        reference = False
+        random_seed = seed & 0xFFFF_FFFF
+
+        def construct(self):
+            source = r"Half: $\frac{x}{2}$" if self.reference else r"Half: $\half{x}$"
+            preamble = "" if self.reference else HALF
+            self.add(m.Title(source, color=m.RED, additional_preamble=preamble))
+            listing = m.BulletedList(source, r"Root: $\sqrt{y}$", numbered=True,
+                                     color=m.BLUE, additional_preamble=preamble)
+            self.add(listing)
+
+    destination = Path(destination)
+    destination.mkdir(parents=True, exist_ok=True)
+    images = []
+    for name, reference, threads in (("math-composed-1.png", False, 1),
+                                     ("math-composed-4.png", False, 4),
+                                     ("math-expanded.png", True, 1)):
+        scene = MathScene()
+        scene.reference = reference
+        path = destination / name
+        scene._begin_png(str(path), 192, 128, 30, threads, seed)
+        try:
+            scene.run()
+            scene._finish_render(scene.frame._core, scene.camera.light_source.get_center())
+        except BaseException:
+            scene._abort_render()
+            raise
+        images.append(path.read_bytes())
+    assert images[0] == images[1], "thread count changed native compositions"
+    assert images[0] == images[2], "macro compositions differ from expanded mathematics"
+    return images[0], checks
+
+
+if __name__ == "__main__":
+    with tempfile.TemporaryDirectory(prefix="fmn-math-compositions-") as directory:
+        png, checks = render_math_compositions(directory)
+    print(f"Mathematical compositions: {checks} acceptance groups and identical 1/4-thread and expanded PNGs ({len(png)} bytes)")
