+/// Rows that meet without a seam: the renderer's antialiasing band at half a pixel. At the
+/// default 1.5 px the background shows through at each boundary between rows, which reads as
+/// fine stripes across the picture (the same fix as `raptorq_gf256`'s `crisp`).
+fn crisp(stage: &mut Stage<'_>, strips: &RowStrips) {
+    for &m in &strips.rows {
+        stage.set_anti_alias_width(m, 0.5, false);
+    }
+}
