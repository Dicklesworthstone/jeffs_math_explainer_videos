+    /// Each label names the whole zero, and no row of the column lines up with a label. The
+    /// half heights are estimates at 18 and 22: the pictures decide.
+    #[test]
+    fn the_zero_labels_name_the_zeros_and_are_no_table() {
+        let st = strip_plane();
