+/// Compiled frames compile only inside a render worker, so only that worker's own compiler can
+/// answer here. The camera route builds neither table, which a zero budget makes visible.
+#[test]
+fn declared_frame_tables_reach_the_compiled_affine_workers_and_not_the_camera_route() {
+    let bytes = painted_bundle();
+    let png_options = |path: &str, camera: bool| {
+        let mut options = options(path, 4, camera);
+        options.format = RenderFormat::PngSequence;
+        options
+    };
+    let fs = Arc::new(VirtualFs::new());
+
+    let mut pieces = png_options("/pieces", false);
+    pieces.frame_table_limits.monotone.max_pieces = 0;
+    let mut references = png_options("/references", false);
+    references.frame_table_limits.binning.max_tile_references = 0;
+    for (path, tight, resource) in [
+        ("/pieces", pieces, "monotone pieces"),
+        ("/references", references, "macrotile references"),
+    ] {
+        let Err(error) = render_bundle_with_fs(&bytes, tight, fs.clone()) else {
+            panic!("{path}: a worker admitted a frame over its declared budget");
+        };
+        assert!(matches!(error, RenderError::Pipeline(_)), "{error:?}");
+        let words = format!("{error:?}");
+        assert!(
+            words.contains(&format!("resource: \"{resource}\"")),
+            "{words}"
+        );
+        assert!(!fs.exists(Path::new(path)));
+    }
+
+    let mut raised = png_options("/raised", false);
+    raised.frame_table_limits.monotone.max_pieces = 1 << 23;
+    raised.frame_table_limits.binning.max_tile_references = 1 << 25;
+    render_bundle_with_fs(&bytes, raised, fs.clone()).unwrap();
+    render_bundle_with_fs(&bytes, png_options("/default", false), fs.clone()).unwrap();
+    for index in 0..4 {
+        let frame = format!("frame_{index:06}.png");
+        assert_eq!(
+            fs.read(&Path::new("/raised").join(&frame)).unwrap(),
+            fs.read(&Path::new("/default").join(&frame)).unwrap()
+        );
+    }
+
+    let mut camera = png_options("/camera", true);
+    camera.frame_table_limits.monotone.max_pieces = 0;
+    camera.frame_table_limits.binning.max_tile_references = 0;
+    render_bundle_with_fs(&bytes, camera, fs.clone()).unwrap();
+    assert!(fs.exists(Path::new("/camera/frame_000000.png")));
+}
