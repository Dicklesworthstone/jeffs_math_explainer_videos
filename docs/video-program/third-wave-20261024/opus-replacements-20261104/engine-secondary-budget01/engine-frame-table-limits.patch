diff --git a/crates/fmn-render/tests/frame_table_limits.rs b/crates/fmn-render/tests/frame_table_limits.rs
new file mode 100644
--- /dev/null
+++ b/crates/fmn-render/tests/frame_table_limits.rs
@@ -0,0 +1,411 @@
+//! Per-frame table budgets on a compiled affine frame: the defaults, the exact boundary of every
+//! budget, the frame-local pieces that bypass the shared table, and no pixel moved by a larger one.
+use fmn_core::color::LinearRgba;
+use fmn_frame::FrameBuffer;
+use fmn_mobject::{Mobject, Placement, RecordBuffer, RecordSchema, Stage};
+use fmn_render::{
+    BinningError, BinningLimits, EngineIdentity, FrameArena, FrameConfig, FrameJobError,
+    FrameTableLimits, MonoPiece, MonoTableError, MonoTableLimits, PixelTileCache, RenderPlanLimits,
+    RetainedFrameRendererConfig, RetainedFrameRendererError, ScreenMap, Tiling,
+    VectorFrameCompiler, Viewport,
+};
+
+const UPRIGHT: [[f64; 3]; 3] = [[1., 0., 0.], [0., 1., 0.], [0., 0., 1.]];
+/// A 45° turn, up to a scale that does not matter here.
+const TURNED: [[f64; 3]; 3] = [[0.7071, -0.7071, 0.], [0.7071, 0.7071, 0.], [0., 0., 1.]];
+
+fn config() -> RetainedFrameRendererConfig {
+    RetainedFrameRendererConfig {
+        frame: FrameConfig::new(
+            Viewport {
+                width: 64,
+                height: 36,
+            },
+            ScreenMap {
+                scale: 4.5,
+                origin: [32., 18.],
+                y_up: false,
+            },
+            LinearRgba {
+                r: 0.,
+                g: 0.,
+                b: 0.,
+                a: 1.,
+            },
+        ),
+        tiling: Tiling {
+            macro_tile: 16,
+            fine_tile: 8,
+        },
+        engine: EngineIdentity::certified(),
+        threads: 1,
+    }
+}
+
+fn filled(points: &[[f32; 3]]) -> Mobject {
+    let mut records = RecordBuffer::new(RecordSchema::vmobject(), points.len()).unwrap();
+    for (i, point) in points.iter().enumerate() {
+        records.write(i, "point", point);
+        records.write(i, "fill_rgba", &[1.0, 0.0, 0.0, 1.0]);
+    }
+    Mobject::from_buffer(records)
+}
+
+/// Past every edge of the frame, so it lands in all 12 macro tiles and all 40 fine tiles.
+fn over_the_whole_frame() -> Stage {
+    let mut stage = Stage::new();
+    let mob = stage.add(filled(&[
+        [-8., -5., 0.],
+        [0., -5., 0.],
+        [8., -5., 0.],
+        [8., 0., 0.],
+        [8., 5., 0.],
+        [0., 5., 0.],
+        [-8., 5., 0.],
+        [-8., 0., 0.],
+        [-8., -5., 0.],
+    ]));
+    stage.add_to_scene(mob).unwrap();
+    stage
+}
+
+/// One open quadratic. Upright it is monotone on both axes: one piece and a closing chord, in the
+/// shared table. Turned 45° its screen x rises and falls, so the frame derives two pieces and the
+/// chord. Three frame-local pieces against two in the table separate the two sites.
+fn turned_curve() -> Stage {
+    let mut stage = Stage::new();
+    let mob = stage.add(filled(&[[0., 0., 0.], [1., 0.5, 0.], [1.5, 1.5, 0.]]));
+    stage.add_to_scene(mob).unwrap();
+    stage
+        .set_placement(mob, Placement::new(TURNED, [0.; 3]))
+        .unwrap();
+    stage
+}
+
+fn render(
+    stage: &Stage,
+    limits: FrameTableLimits,
+) -> Result<FrameBuffer, RetainedFrameRendererError> {
+    let mut compiler = VectorFrameCompiler::new(config())?;
+    compiler.set_frame_table_limits(limits);
+    let frame = compiler.capture(stage, 0)?;
+    let (pixels, _) = frame.render_cached(1, &mut FrameArena::new(), &mut PixelTileCache::new())?;
+    Ok(pixels)
+}
+
+fn monotone(max_pieces: usize, max_table_bytes: usize) -> FrameTableLimits {
+    FrameTableLimits {
+        monotone: MonoTableLimits {
+            max_pieces,
+            max_table_bytes,
+        },
+        ..FrameTableLimits::default()
+    }
+}
+
+fn binning(limits: BinningLimits) -> FrameTableLimits {
+    FrameTableLimits {
+        binning: limits,
+        ..FrameTableLimits::default()
+    }
+}
+
+#[track_caller]
+fn refused_by_table(
+    result: Result<FrameBuffer, RetainedFrameRendererError>,
+    name: &str,
+    at: usize,
+    over: usize,
+) {
+    match result {
+        Err(RetainedFrameRendererError::Mono(MonoTableError::LimitExceeded {
+            resource,
+            limit,
+            requested,
+        })) if resource == name && limit == at && requested == over => {}
+        other => panic!("expected the table to refuse {over} {name} at {at}: {other:?}"),
+    }
+}
+
+#[track_caller]
+fn refused_in_frame(
+    result: Result<FrameBuffer, RetainedFrameRendererError>,
+    name: &str,
+    at: usize,
+    over: usize,
+) {
+    match result {
+        Err(RetainedFrameRendererError::Prepare(FrameJobError::MonoTable(
+            MonoTableError::LimitExceeded {
+                resource,
+                limit,
+                requested,
+            },
+        ))) if resource == name && limit == at && requested == over => {}
+        other => panic!("expected the frame to refuse {over} {name} at {at}: {other:?}"),
+    }
+}
+
+/// The resource named, the limit, and what was asked for, from a binning refusal.
+#[track_caller]
+fn refused_binning(result: Result<FrameBuffer, RetainedFrameRendererError>) -> (String, u64, u64) {
+    match result {
+        Err(RetainedFrameRendererError::Binning(BinningError::LimitExceeded {
+            resource,
+            requested,
+            limit,
+        })) => (resource.to_owned(), limit, requested),
+        other => panic!("expected a binning limit refusal: {other:?}"),
+    }
+}
+
+#[test]
+fn the_default_budgets_are_the_limits_the_engine_always_had() {
+    assert_eq!(
+        FrameTableLimits::default(),
+        FrameTableLimits {
+            monotone: MonoTableLimits {
+                max_pieces: 1 << 22,
+                max_table_bytes: 1 << 28,
+            },
+            binning: BinningLimits {
+                max_tiles: 1 << 20,
+                max_instances: 1 << 20,
+                max_tile_references: 1 << 24,
+                max_partition_cells: 1 << 24,
+                max_working_bytes: 256 * 1024 * 1024,
+            },
+        }
+    );
+}
+
+/// Each site has its own exact boundary. A frame-local site left at its default would pass the
+/// table checks here and then admit what these limits must refuse.
+#[test]
+fn monotone_budgets_govern_the_shared_table_and_the_frame_local_pieces() {
+    let stage = turned_curve();
+    let wide = MonoTableLimits::default();
+
+    refused_by_table(
+        render(&stage, monotone(1, wide.max_table_bytes)),
+        "monotone pieces",
+        1,
+        2,
+    );
+    refused_in_frame(
+        render(&stage, monotone(2, wide.max_table_bytes)),
+        "monotone pieces",
+        2,
+        3,
+    );
+    render(&stage, monotone(3, wide.max_table_bytes)).unwrap();
+
+    // The table also counts its one shape range. The frame-local pool has none.
+    let piece = std::mem::size_of::<MonoPiece>();
+    let table = 2 * piece + std::mem::size_of::<(u32, u32)>();
+    let frame = 3 * piece;
+    refused_by_table(
+        render(&stage, monotone(wide.max_pieces, table - 1)),
+        "monotone table bytes",
+        table - 1,
+        table,
+    );
+    refused_in_frame(
+        render(&stage, monotone(wide.max_pieces, frame - 1)),
+        "monotone table bytes",
+        frame - 1,
+        frame,
+    );
+    render(&stage, monotone(wide.max_pieces, frame)).unwrap();
+}
+
+#[test]
+fn binning_budgets_each_refuse_by_name_at_their_exact_boundary() {
+    let stage = over_the_whole_frame();
+    let wide = BinningLimits::default();
+
+    for (name, lowered, requested, exact) in [
+        (
+            "fine tiles",
+            BinningLimits {
+                max_tiles: 39,
+                ..wide
+            },
+            40,
+            BinningLimits {
+                max_tiles: 40,
+                ..wide
+            },
+        ),
+        (
+            "instances",
+            BinningLimits {
+                max_instances: 0,
+                ..wide
+            },
+            1,
+            BinningLimits {
+                max_instances: 1,
+                ..wide
+            },
+        ),
+        (
+            "partition cells",
+            BinningLimits {
+                max_partition_cells: 39,
+                ..wide
+            },
+            40,
+            BinningLimits {
+                max_partition_cells: 40,
+                ..wide
+            },
+        ),
+        (
+            "fine tile references",
+            BinningLimits {
+                max_tile_references: 39,
+                ..wide
+            },
+            40,
+            BinningLimits {
+                max_tile_references: 40,
+                ..wide
+            },
+        ),
+    ] {
+        let (resource, _, asked) = refused_binning(render(&stage, binning(lowered)));
+        assert_eq!((resource.as_str(), asked), (name, requested));
+        render(&stage, binning(exact)).unwrap();
+    }
+
+    // The macro pass holds 12 references and spends the same budget first.
+    let (resource, _, asked) = refused_binning(render(
+        &stage,
+        binning(BinningLimits {
+            max_tile_references: 11,
+            ..wide
+        }),
+    ));
+    assert_eq!((resource.as_str(), asked), ("macrotile references", 12));
+
+    // Working bytes are checked in stages, each report larger than the last. Walk up them.
+    let mut limit = 1;
+    let mut last_refused = 0;
+    while let Err(error) = render(
+        &stage,
+        binning(BinningLimits {
+            max_working_bytes: limit,
+            ..wide
+        }),
+    ) {
+        let (resource, _, asked) = refused_binning(Err(error));
+        assert_eq!(resource, "working bytes");
+        assert!(asked > limit, "{asked} at {limit}");
+        last_refused = limit;
+        limit = asked;
+    }
+    assert!(last_refused > 0, "one byte should have been refused");
+    assert_eq!(
+        refused_binning(render(
+            &stage,
+            binning(BinningLimits {
+                max_working_bytes: limit - 1,
+                ..wide
+            }),
+        ))
+        .0,
+        "working bytes"
+    );
+}
+
+#[test]
+fn a_larger_budget_moves_no_pixel() {
+    let raised = FrameTableLimits {
+        monotone: MonoTableLimits {
+            max_pieces: 1 << 23,
+            max_table_bytes: 1 << 29,
+        },
+        binning: BinningLimits {
+            max_tiles: 1 << 21,
+            max_instances: 1 << 21,
+            max_tile_references: 1 << 25,
+            max_partition_cells: 1 << 25,
+            max_working_bytes: 512 * 1024 * 1024,
+        },
+    };
+    for stage in [over_the_whole_frame(), turned_curve()] {
+        let default = render(&stage, FrameTableLimits::default()).unwrap();
+        let red = default
+            .plane(0)
+            .as_chunks::<8>()
+            .0
+            .iter()
+            .map(|pixel| fmn_frame::half::f16_to_f64(u16::from_le_bytes([pixel[0], pixel[1]])))
+            .sum::<f64>();
+        assert!(red > 1.0, "the fixture drew nothing: {red}");
+        let larger = render(&stage, raised).unwrap();
+        assert_eq!(default.plane(0), larger.plane(0));
+    }
+}
+
+/// Every lower limit above would also pass if a raise were clamped to the default. This one needs
+/// more than the default: 1,365 distinct outlines of 1,024 quadratics, each split at both extrema.
+/// That is 1,365 × (3 × 1,024 + 1) = 4,194,645 pieces against 4,194,304. Identical outlines would
+/// intern to one shape, so each is shifted. The translation takes them all out of the frame, so
+/// binning and raster stay trivial and the table is the whole cost.
+#[test]
+#[ignore = "about 0.55 GiB by arithmetic, not measured: root runs it under guard"]
+fn a_monotone_budget_above_the_default_is_admitted_and_the_default_still_refuses() {
+    const SHAPES: usize = 1_365;
+    const CURVES: usize = 1_024;
+    let step = 1.0 / CURVES as f32;
+    let mut stage = Stage::new();
+    for shape in 0..SHAPES {
+        let shift = shape as f32 * 0.001;
+        let mut points = Vec::with_capacity(2 * CURVES + 1);
+        for curve in 0..=CURVES {
+            let at = curve as f32 * step + shift;
+            points.push([at, at, 0.0]);
+            if curve < CURVES {
+                // From `at`, handle (2, 3) and end (1, 1) steps: extrema at t = 2/3 and 3/5.
+                points.push([at + 2.0 * step, at + 3.0 * step, 0.0]);
+            }
+        }
+        let mob = stage.add(filled(&points));
+        stage.add_to_scene(mob).unwrap();
+        stage
+            .set_placement(mob, Placement::new(UPRIGHT, [100.0, 0.0, 0.0]))
+            .unwrap();
+    }
+
+    let mut compiler = VectorFrameCompiler::new(config()).unwrap();
+    compiler.set_plan_limits(RenderPlanLimits {
+        max_input_curves: 1 << 21,
+        max_retained_segments: 1 << 21,
+        ..RenderPlanLimits::default()
+    });
+    let render_once = |compiler: &mut VectorFrameCompiler| {
+        compiler
+            .capture(&stage, 0)
+            .unwrap()
+            .render_cached(1, &mut FrameArena::new(), &mut PixelTileCache::new())
+            .map(|(pixels, _)| pixels)
+    };
+    match render_once(&mut compiler) {
+        Err(RetainedFrameRendererError::Mono(MonoTableError::LimitExceeded {
+            resource: "monotone pieces",
+            limit,
+            requested,
+        })) => {
+            assert_eq!(limit, 1 << 22);
+            assert!(requested > limit, "{requested}");
+        }
+        other => panic!("the default should refuse by name: {other:?}"),
+    }
+    compiler.set_frame_table_limits(monotone(
+        1 << 23,
+        MonoTableLimits::default().max_table_bytes,
+    ));
+    render_once(&mut compiler).unwrap();
+}
