+#[test]
+fn a_lowered_frame_table_budget_refuses_by_name_and_publishes_nothing() {
+    let fs = Arc::new(VirtualFs::new());
+
+    let mut pieces = options("/pieces", RenderFormat::PngSequence, 1);
+    pieces.frame_table_limits.monotone.max_pieces = 0;
+    let Err(error) = render_with_fs(&mut MovingCircle, pieces, fs.clone()) else {
+        panic!("a circle needs more than no monotone pieces");
+    };
+    let words = format!("{error:?}");
+    assert!(words.contains("resource: \"monotone pieces\""), "{words}");
+    assert!(!fs.exists(Path::new("/pieces")));
+
+    let mut references = options("/references", RenderFormat::PngSequence, 1);
+    references.frame_table_limits.binning.max_tile_references = 0;
+    let Err(error) = render_with_fs(&mut MovingCircle, references, fs.clone()) else {
+        panic!("a circle on screen needs more than no tile references");
+    };
+    let words = format!("{error:?}");
+    assert!(
+        words.contains("resource: \"macrotile references\""),
+        "{words}"
+    );
+    assert!(!fs.exists(Path::new("/references")));
+}
