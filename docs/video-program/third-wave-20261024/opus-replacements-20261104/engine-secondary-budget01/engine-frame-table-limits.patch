+const FULL_FRAME_LAYERS: usize = 2_057;
+
+/// Binning counts an instance in every tile its bounds touch, before occlusion is pruned. At
+/// 1920×1080 with certified 16-pixel tiles a full-frame layer touches 120 × 68 = 8,160 tiles, so
+/// 2,057 of them need 16,785,120 references against the default of 16,777,216. Working bytes stay
+/// under their default, so one field is all this scene has to declare.
+struct FullFrameLayers;
+
+impl SceneConstruct for FullFrameLayers {
+    fn construct(&mut self, stage: &mut Stage<'_>) -> fmn::Result<()> {
+        for _ in 0..FULL_FRAME_LAYERS {
+            let layer = stage.add(
+                Polygon::new([
+                    [-4.0, -3.0, 0.0],
+                    [4.0, -3.0, 0.0],
+                    [4.0, 3.0, 0.0],
+                    [-4.0, 3.0, 0.0],
+                ])
+                .color(WHITE),
+            )?;
+            stage.set_fill(layer, Some(WHITE), Some(1.0), None, true);
+            stage.set_stroke(layer, None, Some(0.0), None, None, true);
+        }
+        stage.wait(0.1)?;
+        Ok(())
+    }
+}
+
+/// A clamp to the default would pass every lowered budget. This one has to rise, on the route a
+/// film takes.
+#[test]
+fn a_declared_binning_budget_above_the_default_is_admitted_and_the_default_still_refuses() {
+    let layered = |path: &str| {
+        let mut options = options(path, RenderFormat::PngSequence, 1);
+        options.config.camera.resolution = (1920, 1080);
+        options
+    };
+    let fs = Arc::new(VirtualFs::new());
+    let Err(error) = render_with_fs(&mut FullFrameLayers, layered("/refused"), fs.clone()) else {
+        panic!("16,785,120 references should not fit the default budget");
+    };
+    let words = format!("{error:?}");
+    assert!(
+        words.contains("resource: \"fine tile references\"") && words.contains("limit: 16777216"),
+        "{words}"
+    );
+    assert!(!fs.exists(Path::new("/refused")));
+
+    let mut declared = layered("/admitted");
+    declared.frame_table_limits.binning.max_tile_references = 1 << 25;
+    let report = render_with_fs(&mut FullFrameLayers, declared, fs.clone()).unwrap();
+    // Binary f64 0.1 lies just above 1/10: the exact nominal clock emits two frames.
+    assert_eq!(report.artifact.frame_count, 2);
+    assert!(fs.exists(Path::new("/admitted/frame_000000.png")));
+}
