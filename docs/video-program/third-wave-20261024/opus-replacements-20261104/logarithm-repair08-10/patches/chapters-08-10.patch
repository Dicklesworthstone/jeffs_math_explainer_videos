+fn squashed_point((a, b, tilt): (f64, f64, f64), u: f64, r: f64, th: f64) -> [f64; 2] {
+    let short = 1.0 + (b / a - 1.0) * u;
+    model::apply(model::rotation(tilt.to_radians()), [r * th.cos(), short * r * th.sin()])
