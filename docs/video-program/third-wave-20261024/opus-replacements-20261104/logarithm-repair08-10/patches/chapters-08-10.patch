+        let not = phrase_seconds(text, &starts, 30.0, &none, "or does not turn").unwrap();
+        assert!(starts[3] < turns && turns < not && not < starts[4], "{turns} {not}");
+        let text = script.text("10_4").unwrap();
+        let starts = shares(text, 30.0);
