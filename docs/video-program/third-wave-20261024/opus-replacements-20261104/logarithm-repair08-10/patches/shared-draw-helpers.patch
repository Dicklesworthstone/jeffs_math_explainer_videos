 // ---------------------------------------------------------- matrices
 
+/// Clear space between a matrix card's two columns, per unit of text size:
+/// 0.25 scene units at size 30, so a small card grows only as its text does.
+const CARD_COLUMN_GAP: f64 = 0.25 / 30.0;
+/// Clear space between a matrix card's widest entry and its bracket, the same way.
+const CARD_BRACKET_GAP: f64 = 0.10 / 30.0;
+
+/// A card's half column spacing and bracket half width, from its widest
+/// entry: narrow entries keep the spacing they always had, and only wide ones
+/// push the columns and brackets apart.
+fn card_widths(size: f64, widest: f64) -> (f64, f64) {
+    let dx = (size * 0.011).max((widest + size * CARD_COLUMN_GAP) / 2.0);
+    (dx, dx + (size * 0.0095).max(widest / 2.0 + size * CARD_BRACKET_GAP))
+}
