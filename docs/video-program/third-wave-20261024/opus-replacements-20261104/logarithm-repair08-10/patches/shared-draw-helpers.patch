+/// How far past a clip box a point may land and still count as inside. A line
+/// drawn exactly on the box must survive the rounding of a flow's arithmetic:
+/// a flow that is home gives the identity only to about 1e-15.
+const CLIP_SLACK: f64 = 1e-9;
+
+/// Whether a grid point's image lies inside the clip box.
+fn inside_clip(q: [f64; 2], clip: f64) -> bool {
+    q[0].abs() <= clip + CLIP_SLACK && q[1].abs() <= clip + CLIP_SLACK
+}
