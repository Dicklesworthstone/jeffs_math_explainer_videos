+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_line_on_the_clip_box_survives_a_flows_rounding() {
+        // the stretch flow of chapter 10 lands the line x = 2 here at t = 1
+        assert!(inside_clip([3.0000000000000018, 0.0], 3.0));
+        assert!(inside_clip([0.0, -3.0000000000000018], 3.0));
+        // and a point really outside the box stays out
+        assert!(!inside_clip([3.001, 0.0], 3.0));
+        assert!(!inside_clip([0.0, 3.001], 3.0));
+    }
+
+    #[test]
+    fn card_columns_and_brackets_clear_the_widest_entry() {
+        for (size, widest) in [(34.0, 1.039), (30.0, 0.767), (30.0, 0.617), (26.0, 0.332), (32.0, 0.16)] {
+            let (dx, w) = card_widths(size, widest);
+            assert!(2.0 * dx - widest >= size * CARD_COLUMN_GAP - 1e-12, "{size} {widest}");
+            assert!(
+                w - (dx + widest / 2.0) >= size * CARD_BRACKET_GAP - 1e-12,
+                "{size} {widest}"
+            );
+        }
+    }
+
+    #[test]
+    fn a_small_card_grows_only_as_its_text_does() {
+        // "−1" at size 20: a small card stays within 0.01 of its old half width
+        let (_, w) = card_widths(20.0, 0.256);
+        assert!((w - (20.0 * 0.011 + 20.0 * 0.0095)).abs() < 0.01, "{w}");
+    }
+
+    #[test]
+    fn narrow_entries_keep_the_cards_old_spacing() {
+        // one digit at the size of the identity card
+        let (dx, w) = card_widths(32.0, 0.16);
+        assert_eq!(dx, 32.0 * 0.011);
+        assert_eq!(w, 32.0 * 0.011 + 32.0 * 0.0095);
+    }
