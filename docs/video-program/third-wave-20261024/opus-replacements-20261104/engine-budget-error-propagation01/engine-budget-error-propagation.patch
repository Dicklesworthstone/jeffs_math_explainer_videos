+impl RenderError {
+    /// Whether this capture failure can stand in for a frame-stage error that
+    /// the pipeline still holds. A closed admission stream is one. An output
+    /// slot abandoned by a worker is the other: a worker that refuses a frame
+    /// drops its reservation as it returns, before it raises cancellation, so
+    /// a capture waiting on a full output ring (a slow sink) can wake to the
+    /// abandonment first. A sink's own failure is recorded first, wins over
+    /// any later abandonment, and is never in this set.
+    fn may_hide_stage_failure(&self) -> bool {
+        matches!(
+            self,
+            Self::Pipeline(_) | Self::Emitter(EmitterError::ReservationAbandoned { .. })
+        )
+    }
+}
