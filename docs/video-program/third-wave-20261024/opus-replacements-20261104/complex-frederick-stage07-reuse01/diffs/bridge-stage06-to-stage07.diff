+def compare_narration(new, old, script, cue):
+    """Every cue but the corrected one must be stage06's narration: same WAV, same report rows but for the decoded path,
+    same phrase marks. The corrected cue must keep its sentence count, which the ts1 row counts rest on."""
+    report, stage06 = load_json(new / "report.json")["lines"], load_json(old / "report.json")["lines"]
+    marks, marks6 = load_json(new / "phrase-timings.json")["cues"], load_json(old / "phrase-timings.json")["cues"]
+    problems = []
+    if list(report) != list(stage06) or sorted(report) != sorted(script) or list(marks) != list(marks6):
+        raise Refused("the narration does not cover the script's cues in stage06's order")
+    for name in script:
+        if name == cue:
+            continue
+        if sha_file(new / f"{name}.wav") != sha_file(old / f"{name}.wav"):
+            problems.append(f"{name}: the WAV is not stage06's")
+        strip = lambda rows: [{key: value for key, value in row.items() if key != "source"} for row in rows]
+        if strip(report[name]) != strip(stage06[name]):
+            problems.append(f"{name}: the report rows differ beyond the decoded path")
+        if marks[name] != marks6[name]:
+            problems.append(f"{name}: the phrase timing entry differs")
+    if len(report[cue]) != len(stage06[cue]):
+        problems.append(f"{cue}: {len(report[cue])} sentences, stage06 had {len(stage06[cue])}")
+    if problems:
+        raise Refused("\n".join(problems))
+    return {"cues_identical": len(script) - 1, "cue_changed": cue, "sentences_in_changed_cue": len(report[cue]),
+            "report_rows": sum(len(rows) for rows in report.values()),
+            "changed_cue_samples_24k": {"stage06": sum(r["out_samples"] for r in stage06[cue]),
+                                        "stage07": sum(r["out_samples"] for r in report[cue])}}
+
+
+def cmd_rows(args):
+    intake = dep("intake")
+    narration, out = Path(args.narration), Path(args.out)
+    if out.exists() or not out.parent.is_dir():
+        raise Refused("--out must be a new file in an existing folder")
+    _side, script, _files = source_side(Path(args.crate))
+    assembly = load_json(narration / "assembly.json")
+    if sha_file(narration / "report.json") != assembly["report_sha256"]:
+        raise Refused("the narration's assembly does not bind its report")
+    if load_json(narration / "phrase-timings.json").get("script_sha256") != intake.PINS["script"]:
+        raise Refused("the narration's phrase timings bind another script")
+    comparison = compare_narration(narration, REPO / intake.STAGE06["narration"], script, intake.REPAIR["cue"])
+    paths = {p for p in narration.iterdir() if p.is_file()}
+    tree = Path(args.tree or REPO / intake.NATIVE) / "tree-receipt.json"
+    paths.add(tree)
+    paths |= {REPO / row["path"] for row in load_json(tree)["files"]}
+    receipts = {unit["generation_receipt"] for unit in assembly["manifest"]["units"]}
+    if len(receipts) != 1:
+        raise Refused(f"expected one decode receipt, found {len(receipts)}")
+    receipt = next(iter(receipts))
+    paths.add(REPO / receipt)
+    records = load_json(REPO / receipt)["records"]
+    if [row["cue"] for row in records] != list(script):
+        raise Refused("the decode receipt does not cover the script's cues in order")
+    for row in records:
+        paths |= {REPO / row["wav"], REPO / row["source"], REPO / row["request"]}
+        if row.get("generation"):
+            takes = REPO / intake.TAKES
+            paths |= {takes / intake.REPAIR[kind][0] for kind in ("request", "submission", "downloads")}
+            paths |= {takes / name for name in intake.REPAIR["takes"]}
+    if sum(1 for row in records if row.get("generation")) != 1:
+        raise Refused("exactly one cue must carry root's repair receipts")
+    rows = [{"path": rel(p), "sha256": sha_file(p)} for p in sorted(paths)]
+    write_new(out, dumps({"schema": SCHEMA, "kind": "rows", "tool": rel(HERE), "tool_sha256": sha_file(HERE),
+                          "script_sha256": intake.PINS["script"], "narration": rel(narration),
+                          "decode_receipt": {"path": receipt, "sha256": sha_file(REPO / receipt)},
+                          "comparison": comparison, "files": rows,
+                          "claim": "Hashes and source-bound comparison only. No listening, fine sync or acceptance."}))
+    print(dumps({"rows": rel(out), "sha256": sha_file(out), "files": len(rows), **comparison}), end="")
+    return 0
