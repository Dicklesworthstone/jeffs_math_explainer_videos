+        ),
+        (
+            "raster triangles",
+            |limits, value| limits.max_raster_triangles = value,
+            64,
+        ),
+        (
+            "preparation working bytes",
+            |limits, value| limits.max_working_bytes = value,
+            ThreeDPreparationLimits::default().max_working_bytes,
+        ),
+    ];
+    for (resource, set, ceiling) in budgets {
+        let [caller, worker] = ROUTES
+            .map(|(_, route)| smallest_admitted(route, &stage, &camera, set, resource, ceiling));
+        assert_eq!(caller, worker, "{resource}");
+        let expected = match resource {
+            "draw rows" | "projected curves" => Some(4),
+            "raster triangles" => Some(6),
+            _ => None,
+        };
+        if let Some(expected) = expected {
+            assert_eq!(caller, expected, "{resource}");
+        }
+    }
+}
