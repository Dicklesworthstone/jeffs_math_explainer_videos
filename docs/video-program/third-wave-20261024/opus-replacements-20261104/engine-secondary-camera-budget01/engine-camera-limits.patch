+/// A stroke-only curve that nothing clips or subdivides is charged 88 + 2 × 184 + 160 + 88 = 704
+/// working bytes, so 800,000 of them ask 563,200,000 against the default's 536,870,912, whatever
+/// else the frame costs. They stay under the plan's own 1 << 20 curves, so nothing else needs
+/// declaring. Each shape is about 5 pixels across, which keeps the raster small.
+#[test]
+#[ignore = "about 0.4 GB by arithmetic, not measured: root runs it under guard"]
+fn a_working_byte_budget_above_the_default_is_admitted_and_the_default_still_refuses() {
+    const SHAPES: usize = 800;
+    const CURVES: usize = 1_000;
+    let step = 1.0 / CURVES as f32;
+    let mut stage = Stage::new();
+    for shape in 0..SHAPES {
+        let shift = shape as f32 * 0.001;
+        let mut points = Vec::with_capacity(2 * CURVES + 1);
+        for curve in 0..=CURVES {
+            let at = curve as f32 * step + shift;
+            points.push([at, 0.5 * at, 0.0]);
+            if curve < CURVES {
+                let middle = at + 0.5 * step;
+                points.push([middle, 0.5 * middle, 0.0]);
+            }
+        }
+        let mob = stage.add(outlined(&points, 0.0));
+        stage.add_to_scene(mob).unwrap();
+    }
+    let camera = head_on();
+    let default = ThreeDPreparationLimits::default();
+    for (name, route) in ROUTES {
+        match route(&stage, &camera, default) {
+            Err(RetainedFrameRendererError::ThreeD(ThreeDError::PreparationLimitExceeded {
+                resource: "preparation working bytes",
+                limit,
+                requested,
+            })) => {
+                assert_eq!(limit, default.max_working_bytes, "{name}");
+                assert!(requested > limit, "{name}: {requested}");
+            }
+            other => panic!("{name}: the default should refuse by name: {other:?}"),
+        }
+    }
+    let raised = ThreeDPreparationLimits {
+        max_working_bytes: 1 << 30,
+        ..default
+    };
+    assert_eq!(
+        on_the_caller(&stage, &camera, raised).unwrap(),
+        on_a_worker(&stage, &camera, raised).unwrap()
+    );
+}
