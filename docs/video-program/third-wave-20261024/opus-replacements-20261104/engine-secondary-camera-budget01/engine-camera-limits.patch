+#[test]
+fn a_camera_budget_moves_no_pixel_on_either_route() {
+    let stage = binned_zigzag();
+    let camera = tilted();
+    let default = ThreeDPreparationLimits::default();
+    let raised = ThreeDPreparationLimits {
+        max_draws: default.max_draws * 2,
+        max_projected_curves: default.max_projected_curves * 2,
+        max_fill_pieces: default.max_fill_pieces * 2,
+        max_raster_triangles: default.max_raster_triangles * 2,
+        max_working_bytes: default.max_working_bytes * 2,
+        max_curve_bin_entries: u64::MAX,
+    };
+    let scanned = ThreeDPreparationLimits {
+        max_curve_bin_entries: 0,
+        ..default
+    };
+    let expected = on_the_caller(&stage, &camera, default).unwrap();
+    let (first, rest) = expected.as_chunks::<8>().0.split_first().unwrap();
+    assert!(
+        rest.iter().any(|pixel| pixel != first),
+        "the scene drew nothing to compare"
+    );
+    for (name, route) in ROUTES {
+        for limits in [default, raised, scanned] {
+            assert_eq!(
+                route(&stage, &camera, limits).unwrap(),
+                expected,
