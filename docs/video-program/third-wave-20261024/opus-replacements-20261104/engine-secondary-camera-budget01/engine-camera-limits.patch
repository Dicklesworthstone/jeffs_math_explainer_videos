@@ -0,0 +1,334 @@
+//! Camera budgets on the retained renderer: the defaults, one boundary per budget on both the
+//! synchronous and the worker route, no pixel moved by a budget, and a real scene over the default.
+use fmn_core::color::LinearRgba;
+use fmn_mobject::{Mobject, RecordBuffer, RecordSchema, RenderPrimitive, Stage};
+use fmn_render::{
+    Camera, CameraConfig, EngineIdentity, FrameConfig, RetainedFrameRenderer,
+    RetainedFrameRendererConfig, RetainedFrameRendererError, ScreenMap, ThreeDError,
+    ThreeDPreparationLimits, Tiling, Viewport,
+};
+
+fn config() -> RetainedFrameRendererConfig {
+    RetainedFrameRendererConfig {
+        frame: FrameConfig::new(
+            Viewport {
+                width: 64,
+                height: 36,
+            },
+            ScreenMap {
+                scale: 4.5,
+                origin: [32., 18.],
+                y_up: false,
+            },
+            background(),
+        ),
+        tiling: Tiling {
+            macro_tile: 16,
+            fine_tile: 8,
+        },
+        engine: EngineIdentity::certified(),
+        threads: 1,
+    }
+}
+
+fn background() -> LinearRgba {
+    LinearRgba {
+        r: 0.,
+        g: 0.,
+        b: 0.,
+        a: 1.,
+    }
+}
+
+fn head_on() -> Camera {
+    Camera::new(CameraConfig {
+        resolution: (64, 36),
+        background: background(),
+        ..Default::default()
+    })
+    .unwrap()
+}
+
+fn tilted() -> Camera {
+    let mut config = CameraConfig {
+        resolution: (64, 36),
+        background: background(),
+        ..Default::default()
+    };
+    config
+        .frame
+        .set_euler_angles(Some(0.4), Some(0.7), None)
+        .unwrap();
+    Camera::new(config).unwrap()
+}
+
+fn outlined(points: &[[f32; 3]], fill_alpha: f32) -> Mobject {
+    let mut records = RecordBuffer::new(RecordSchema::vmobject(), points.len()).unwrap();
+    for (i, point) in points.iter().enumerate() {
+        records.write(i, "point", point);
+        records.write(i, "fill_rgba", &[1.0, 0.0, 0.0, fill_alpha]);
+        records.write(i, "stroke_rgba", &[0.0, 0.0, 1.0, 1.0]);
+        records.write(i, "stroke_width", &[4.0]);
+    }
+    Mobject::from_buffer(records)
+}
+
+fn dots(points: &[[f32; 3]]) -> Mobject {
+    let schema = RecordSchema::new(
+        &[("point", 3), ("radius", 1), ("rgba", 4), ("glow_factor", 1)],
+        &["point"],
+        &["point"],
+    )
+    .unwrap();
+    let mut records = RecordBuffer::new(schema, points.len()).unwrap();
+    for (i, point) in points.iter().enumerate() {
+        records.write(i, "point", point);
+        records.write(i, "radius", &[0.4]);
+        records.write(i, "rgba", &[0.2, 1.0, 0.2, 1.0]);
+        records.write(i, "glow_factor", &[0.0]);
+    }
+    Mobject::from_buffer(records).with_render_primitive(RenderPrimitive::DotCloud)
+}
+
+/// One filled, outlined square of four straight curves, and three dots well inside the frame:
+/// four draws, four projected curves under a head-on camera, six raster triangles.
+fn square_and_dots() -> Stage {
+    let mut stage = Stage::new();
+    let square = stage.add(outlined(
+        &[
+            [-2., -2., 0.],
+            [0., -2., 0.],
+            [2., -2., 0.],
+            [2., 0., 0.],
+            [2., 2., 0.],
+            [0., 2., 0.],
+            [-2., 2., 0.],
+            [-2., 0., 0.],
+            [-2., -2., 0.],
+        ],
+        1.0,
+    ));
+    stage.add_to_scene(square).unwrap();
+    let cloud = stage.add(dots(&[[-1., 0., 0.], [0., 0., 0.], [1., 0., 0.]]));
+    stage.add_to_scene(cloud).unwrap();
+    stage
+}
+
+/// Forty curves in one stroked vector, enough to be binned under the default, beside the square.
+fn binned_zigzag() -> Stage {
+    let mut stage = square_and_dots();
+    let mut points = Vec::new();
+    for curve in 0..=40 {
+        let x = -6.0 + 0.3 * curve as f32;
+        let y = if curve % 2 == 0 { -1.5 } else { 1.5 };
+        points.push([x, y, 0.0]);
+        if curve < 40 {
+            points.push([x + 0.15, 0.0, 0.0]);
+        }
+    }
+    let zigzag = stage.add(outlined(&points, 0.0));
+    stage.add_to_scene(zigzag).unwrap();
+    stage
+}
+
+type Rendered = Result<Vec<u8>, RetainedFrameRendererError>;
+type Route = fn(&Stage, &Camera, ThreeDPreparationLimits) -> Rendered;
+
+fn on_the_caller(stage: &Stage, camera: &Camera, limits: ThreeDPreparationLimits) -> Rendered {
+    let mut renderer = RetainedFrameRenderer::new(config())?;
+    renderer.set_camera_limits(limits);
+    renderer.render_with_camera(stage, camera)?;
+    Ok(renderer.frame().plane(0).to_vec())
+}
+
+fn on_a_worker(stage: &Stage, camera: &Camera, limits: ThreeDPreparationLimits) -> Rendered {
+    let mut renderer = RetainedFrameRenderer::new(config())?;
+    renderer.set_camera_limits(limits);
+    let frame = renderer.prepare_with_camera(stage, camera)?;
+    Ok(frame.render(1)?.plane(0).to_vec())
+}
+
+const ROUTES: [(&str, Route); 2] = [("caller", on_the_caller), ("worker", on_a_worker)];
+
+/// The smallest value `set` can give this budget and still render, from the renderer's own
+/// answers. Every value tried below it must refuse under this resource's name.
+fn smallest_admitted(
+    route: Route,
+    stage: &Stage,
+    camera: &Camera,
+    set: fn(&mut ThreeDPreparationLimits, u64),
+    resource: &str,
+    ceiling: u64,
+) -> u64 {
+    let refused = |value: u64| {
+        let mut limits = ThreeDPreparationLimits::default();
+        set(&mut limits, value);
+        match route(stage, camera, limits) {
+            Ok(_) => false,
+            Err(RetainedFrameRendererError::ThreeD(ThreeDError::PreparationLimitExceeded {
+                resource: named,
+                limit,
+                requested,
+            })) => {
+                assert_eq!(named, resource);
+                assert_eq!(limit, value);
+                assert!(requested > limit, "{requested} against {limit}");
+                true
+            }
+            Err(other) => panic!("{resource} at {value}: {other:?}"),
+        }
+    };
+    let (mut low, mut high) = (0, ceiling);
+    assert!(refused(low), "{resource} admitted nothing at all");
+    assert!(!refused(high), "{resource} refused its ceiling");
+    while high - low > 1 {
+        let middle = low + (high - low) / 2;
+        if refused(middle) {
+            low = middle;
+        } else {
+            high = middle;
+        }
+    }
+    high
+}
+
+#[test]
+fn the_default_camera_budgets_are_the_limits_the_engine_always_had() {
+    assert_eq!(
+        ThreeDPreparationLimits::default(),
+        ThreeDPreparationLimits {
+            max_draws: 1 << 20,
+            max_projected_curves: 1 << 22,
+            max_fill_pieces: 1 << 22,
+            max_raster_triangles: 1 << 22,
+            max_working_bytes: 512 * 1024 * 1024,
+            max_curve_bin_entries: 1 << 24,
+        }
+    );
+}
+
+#[test]
