+    /// Read from the source, because no render can run here. Beside the heading x + 2iy, the
+    /// reflection's "up: −1" reads as doubling's rate, which is 2, so its numbers leave before
+    /// that heading comes. They must not be listed again at the close: a second fade brings a
+    /// faded mob back for a frame. The verdict stays, since it is as true of doubling.
+    #[test]
+    fn the_reflections_numbers_leave_before_doublings_heading() {
+        let source = include_str!("one_derivative.rs");
+        let cue = source.find("let line = say(&kit, stage, \"06_9\")?;").unwrap();
+        let scene = &source[cue..cue + source[cue..].find("kit.finish(stage)").unwrap()];
+        let sentence = scene.find("line.wait_sentence(stage, 4)?;").unwrap();
+        let list = scene.find("let mut reflection = ").unwrap();
+        let leaves = scene.find("fade_out_all(stage, &reflection, 0.3)?;").unwrap();
+        let heading = scene.find("let squash_says = ").unwrap();
+        assert!(sentence < list && list < leaves && leaves < heading);
+        let closing = &scene[scene.find("let mut all = ").unwrap()..];
+        let names = |text: &str, name: &str| {
+            text.split(|c: char| !c.is_alphanumeric() && c != '_')
+                .any(|word| word == name)
+        };
+        for name in ["r1", "r2", "cross1"] {
+            assert!(names(&scene[list..leaves], name), "{name} stays beside the new heading");
+            assert!(!names(closing, name), "{name} fades twice");
+        }
+        assert!(!names(&scene[list..leaves], "no_derivative") && names(closing, "no_derivative"));
+    }
+
+    #[test]
+    fn the_right_column_reads_rates_then_cross_then_verdict() {
+        // half heights in scene units, measured at 1280 × 720 on frame 450 of 06
+        let stack = [(DOUBLING_RATES_AT, 0.13), (CROSS_AT, 0.26), (VERDICT_AT, 0.11)];
+        for pair in stack.windows(2) {
+            let ((upper, upper_half), (lower, lower_half)) = (pair[0], pair[1]);
+            assert_eq!(upper.0, lower.0);
+            assert!(
+                upper.1 - upper_half > lower.1 + lower_half,
+                "{upper:?} runs into {lower:?}"
+            );
+        }
+    }
