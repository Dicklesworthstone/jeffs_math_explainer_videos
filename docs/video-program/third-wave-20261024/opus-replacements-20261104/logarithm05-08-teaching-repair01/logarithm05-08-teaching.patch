+    #[test]
+    fn the_input_dot_leaves_the_labelled_ticks_along_the_arrow_and_is_gone_at_its_tip() {
+        // on the strip it stands where it says, whole
+        for y in [0.0, PI, TAU, IN_Y] {
+            assert_eq!(strip_dot(y), (y, 1.0));
+        }
+        // past the top it never stands still on the 3π tick: higher and fainter each step
+        let mut last = strip_dot(IN_Y);
+        for k in 1..=16 {
+            let now = strip_dot(IN_Y + PAST_STRIP * f64::from(k) / 16.0);
+            assert!(now.0 > last.0 && now.1 < last.1, "{k}: {now:?} after {last:?}");
+            last = now;
+        }
+        // it is gone at the arrow's tip, long before the climb ends
+        assert!(last.1 < 1e-9);
+        assert_eq!(strip_dot(CLIMB_END).1, 0.0);
+        const { assert!(IN_Y + PAST_STRIP < CLIMB_END) };
+        // the tip in input units is the arrow's tip on screen, and stays in the frame
+        let tip = IN.p(C::new(0.0, IN_Y + PAST_STRIP))[1];
+        assert!((tip - (IN.p(C::new(0.0, IN_Y))[1] + GOES_ON_TIP)).abs() < 1e-12);
+        assert!(tip < SAFE[1]);
+    }
+
+    #[test]
+    fn a_phrase_lands_on_its_mark_or_on_its_share_of_the_measured_sentence() {
+        let text = "One two. Three four five six. Seven.";
+        let starts = [0.2, 2.0, 6.0];
+        let none = std::collections::HashMap::new();
+        // eleven of the sentence's twenty characters come before "five"
+        let t = phrase_seconds(text, "five", &none, &starts, 8.0).unwrap();
+        assert!((t - (2.0 + 4.0 * 11.0 / 20.0)).abs() < 1e-12);
+        // a measured word mark wins
+        let marks = std::collections::HashMap::from([(text.find("five").unwrap(), 3.25)]);
+        let t = phrase_seconds(text, "five", &marks, &starts, 8.0).unwrap();
+        assert!((t - 3.25).abs() < 1e-12);
+        // never a guess
+        assert!(phrase_seconds(text, "nine", &none, &starts, 8.0).is_err());
+        assert!(phrase_seconds(text, "five", &none, &starts[..2], 8.0).is_err());
+    }
+}
