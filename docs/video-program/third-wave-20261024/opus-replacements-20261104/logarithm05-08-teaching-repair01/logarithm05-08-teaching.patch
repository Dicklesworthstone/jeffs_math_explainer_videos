+            let [left, right, bottom, _] = box_of(stage, whole);
+            for src in [r"e^{\ln 2 + iy}", r"e^{\ln 2 + i\pi/2}"] {
+                let part = example_part(&kit, stage, src, whole)?;
+                let [l, r, b, _] = box_of(stage, part);
+                assert!((l - left).abs() < 1e-6 && (b - bottom).abs() < 1e-6, "{src}: {l} {b}");
+                assert!(r < right - 0.3, "{src} reaches where the answer goes");
+                assert!(!src.contains('='), "{src} gives the answer away");
+            }
+            Ok(())
