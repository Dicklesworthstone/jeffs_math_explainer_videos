+
+/// How much of "R" and its backing shows at walk angle `th`.
+fn r_name_opacity(th: f64) -> f64 {
+    ((th - R_NAME_SHOWN[0]) / (R_NAME_SHOWN[1] - R_NAME_SHOWN[0])).clamp(0.0, 1.0)
