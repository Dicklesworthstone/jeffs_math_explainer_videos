+    /// One mark, from the first fade to the last: everything that reaches the pole comes in under it,
+    /// and it is too small to hide the walk. 14_3's disks and region are all listed here, so a new
+    /// disk fails until it is routed under the mark too.
+    #[test]
+    fn the_poles_mark_stays_on_top_of_all_that_reaches_it() {
+        let source = include_str!("continuing.rs");
+        let from = source.find("say(&kit, stage, \"14_3\")").unwrap();
+        let to = source.find("let doubling = kit.tex(").unwrap();
+        let scene = &source[from..to];
+        for (mobs, fade) in [
+            ("&[region]", "fade_in_all(stage, &[region, region_says], 0.5)?;"),
+            ("&[first]", "fade_in_all(stage, &[first], 0.6)?;"),
+            ("&[d, piece]", "fade_in_all(stage, &[d, piece], 0.3)?;"),
+        ] {
+            let root = format!("root_under(stage, {mobs}, &pole1)?;");
+            let rooted = scene.find(&root).unwrap_or_else(|| panic!("{root}"));
+            assert!(rooted < scene.find(fade).unwrap(), "{root}");
+        }
+        // the unit disk is the one that goes on before the mark; these three are all there are
+        assert_eq!(scene.matches(" = disk(").count(), 3);
+        assert!(scene.find("let unit = disk(").unwrap() < scene.find("fade_in_all(stage, &pole1, 0.3)?;").unwrap());
+        // the mark goes back after what it covers (read above the tests, which name the same text),
+        // and one mark comes and goes
+        let helper = source.find("fn root_under").unwrap();
+        assert!(source[helper..from].contains("for &m in mobs.iter().chain(mark) {"));
+        assert_eq!(scene.matches("pole_mark(").count(), 1);
+        assert!(scene.contains("gone.extend(pole1);"));
+        // the backing's 0.13 and the walker's 0.08 are scene units, and here one plane unit is one
+        assert!((chain_plane().unit() - 1.0).abs() < 1e-12);
+        for w in model::chain_centres(8).windows(2) {
+            // the centres are all 1 from the pole, so each piece comes nearest it at its middle
+            assert!(((w[0] + w[1]).scale(0.5) - ONE).abs() > 0.13 + 0.08, "{w:?}");
+        }
+    }
