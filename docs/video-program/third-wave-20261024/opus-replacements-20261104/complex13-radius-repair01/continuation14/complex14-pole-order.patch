+/// Root `mobs` under the pole's mark, so a fill or rim that reaches the pole stops at the mark. A fade
+/// roots only what is not on stage yet, and on top, so this has to come before the fade that brings them in.
+fn root_under(stage: &mut Stage<'_>, mobs: &[Mob], mark: &[Mob; 2]) -> fmn::Result<()> {
+    for &m in mobs.iter().chain(mark) {
+        stage.add_to_scene(m)?;
+    }
+    Ok(())
 }
 
