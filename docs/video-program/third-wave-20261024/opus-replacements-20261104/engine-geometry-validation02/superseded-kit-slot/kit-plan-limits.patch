+//! A budget a chapter declares in its `make` reaches the renderer on every
+//! route the shared CLI has: a draft and a `--crf` delivery, each on the
+//! retained and the camera route, plus the thumbnail and the glyph probe.
+//! `--crf` and a camera draft both replace the options with the delivery
+//! ones, which is where a declaration would be lost.
+//!
+//! The observable is a budget too small for the scene. The chapters draw the
+//! same picture and differ only in what they declare, so on any one route a
+//! refusal can only be the declaration arriving, and a roomy declaration or
+//! none shows the route itself works. This does not exercise a budget above
+//! the default: that takes a scene of a million knots, which the engine's own
+//! test and the plate lab carry. Needs ffmpeg on PATH (the renders are MP4).
+
+use std::path::{Path, PathBuf};
+
+use explainer_kit::kit::CameraShot;
+use explainer_kit::{Chapter, Explainer, Facts, Kit, Palette, v};
+use explainer_score::score::Identity;
+use fmn::prelude::*;
+use fmn::rendering::RenderPlanLimits;
+
+const STRAIGHT_ON: CameraShot = CameraShot { theta: 0.0, phi: 0.0 };
+
+/// Far below what the word "flat" needs, so no route can admit the scene.
+fn tight() -> RenderPlanLimits {
+    RenderPlanLimits {
+        max_retained_segments: 1,
+        ..RenderPlanLimits::default()
+    }
+}
+
+/// What a film's dense plate declares.
+fn roomy() -> RenderPlanLimits {
+    RenderPlanLimits {
+        max_retained_profile_knots: 1 << 22,
+        ..RenderPlanLimits::default()
+    }
+}
+
+struct Flat {
+    kit: Kit,
+}
+
+impl SceneConstruct for Flat {
+    fn construct(&mut self, stage: &mut Stage<'_>) -> fmn::Result<()> {
+        let kit = self.kit.clone();
+        let t = kit.text(stage, "flat", 20.0, Palette::ink(), v(0.0, 0.0))?;
+        stage.play(write(stage.arena(), t))?;
+        kit.finish(stage)
+    }
+}
+
+fn make_open(kit: Kit) -> Box<dyn SceneConstruct> {
+    Box::new(Flat { kit })
+}
+
+fn make_tight(kit: Kit) -> Box<dyn SceneConstruct> {
+    kit.request_plan_limits(tight());
+    Box::new(Flat { kit })
+}
+
+fn chapters() -> Vec<Chapter> {
+    vec![
+        Chapter {
+            key: "01_open",
+            make: make_open,
+            intensity: 0.4,
+        },
+        Chapter {
+            key: "02_roomy",
+            make: |kit| {
+                kit.request_plan_limits(roomy());
+                Box::new(Flat { kit })
+            },
+            intensity: 0.4,
+        },
+        Chapter {
+            key: "03_tight",
+            make: make_tight,
+            intensity: 0.4,
+        },
+        Chapter {
+            key: "04_camera_open",
+            make: |kit| {
+                kit.request_camera(STRAIGHT_ON);
+                Box::new(Flat { kit })
+            },
+            intensity: 0.4,
+        },
+        Chapter {
+            key: "05_camera_roomy",
+            make: |kit| {
+                kit.request_camera(STRAIGHT_ON);
+                kit.request_plan_limits(roomy());
+                Box::new(Flat { kit })
+            },
+            intensity: 0.4,
+        },
+        Chapter {
+            key: "06_camera_tight",
+            make: |kit| {
+                kit.request_camera(STRAIGHT_ON);
+                kit.request_plan_limits(tight());
+                Box::new(Flat { kit })
+            },
+            intensity: 0.4,
+        },
+    ]
+}
+
+fn only_open() -> Vec<Chapter> {
+    vec![Chapter {
+        key: "01_open",
+        make: make_open,
+        intensity: 0.4,
+    }]
+}
+
+fn only_tight() -> Vec<Chapter> {
+    vec![Chapter {
+        key: "03_tight",
+        make: make_tight,
+        intensity: 0.4,
+    }]
+}
+
+fn only_camera_tight() -> Vec<Chapter> {
+    vec![Chapter {
+        key: "06_camera_tight",
+        make: |kit| {
+            kit.request_camera(STRAIGHT_ON);
+            kit.request_plan_limits(tight());
+            Box::new(Flat { kit })
+        },
+        intensity: 0.4,
+    }]
+}
+
+fn facts() -> Result<Facts, String> {
+    let mut f = Facts::new();
+    f.pin("c_10_4", explainer_kit::choose(10, 4), "210", "math.comb")?;
+    Ok(f)
+}
+
+fn explainer(chapters: fn() -> Vec<Chapter>) -> Explainer {
+    Explainer {
+        crate_name: "toy",
+        script: "",
+        chapters,
+        facts,
+        glyph_text: &["flat"],
+        glyph_tex: &[],
+        glyph_mono: &[],
+        identity: Identity::hoeffding,
+        narration_gain_db: explainer_kit::narration::GAIN_DB,
+        line_gaps: explainer_kit::narration::LineGaps::Constant,
+        line_owner: None,
+        thumbnail: None,
+    }
+}
+
+fn fresh_dir(tag: &str) -> PathBuf {
+    let nanos = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    std::env::temp_dir().join(format!(
+        "explainer_kit_plan_limits_{tag}_{}_{nanos}",
+        std::process::id()
+    ))
+}
+
+fn run(e: &Explainer, line: &str, out: &Path) -> i32 {
+    let argv = format!("{line} --out {}", out.display());
+    explainer_kit::cli::run(e, argv.split_whitespace().map(str::to_owned))
+}
+
+fn render_one(chapter: &str, extra: &str, out: &Path) -> i32 {
+    let line = format!("render {chapter} --res 64x36 --fps 10 --silent{extra}");
+    run(&explainer(chapters), &line, out)
+}
+
+#[test]
+fn a_declared_budget_reaches_every_render_route() {
+    assert!(
+        std::process::Command::new("ffmpeg")
+            .arg("-version")
+            .output()
+            .is_ok_and(|o| o.status.success()),
+        "this test needs ffmpeg on PATH"
+    );
+    for (route, extra) in [("draft", ""), ("delivery", " --crf 23 --preset ultrafast")] {
+        let out = fresh_dir(route);
+        for chapter in ["01_open", "02_roomy", "04_camera_open", "05_camera_roomy"] {
+            assert_eq!(render_one(chapter, extra, &out), 0, "{route} {chapter} should render");
+            assert!(out.join(format!("{chapter}.mp4")).is_file(), "{route} {chapter}");
+        }
+        for chapter in ["03_tight", "06_camera_tight"] {
+            assert_ne!(
+                render_one(chapter, extra, &out),
+                0,
+                "{route} {chapter} ignored its budget"
+            );
+            assert!(
+                !out.join(format!("{chapter}.mp4")).exists(),
+                "{route} {chapter} published"
+            );
+        }
+    }
+}
+
+#[test]
+fn a_declared_budget_reaches_the_thumbnail() {
+    let out = fresh_dir("thumbnail");
+    let mut e = explainer(chapters);
+    e.thumbnail = Some(make_open);
+    assert_eq!(run(&e, "thumbnail --res 64x36", &out), 0);
+    assert!(out.join("toy_thumbnail.png").is_file());
+    let out = fresh_dir("thumbnail_tight");
+    e.thumbnail = Some(make_tight);
+    assert_ne!(
+        run(&e, "thumbnail --res 64x36", &out),
+        0,
+        "the thumbnail ignored its budget"
+    );
+    assert!(!out.join("toy_thumbnail.png").exists());
+}
+
+#[test]
+fn a_declared_budget_reaches_the_glyph_probe() {
+    let probe = |chapters: fn() -> Vec<Chapter>, tag: &str| {
+        let out = fresh_dir(tag);
+        let line = format!("glyphs {} --res 960x540", out.display());
+        explainer_kit::cli::run(&explainer(chapters), line.split_whitespace().map(str::to_owned))
+    };
+    assert_eq!(probe(only_open, "glyphs_open"), 0);
+    assert_ne!(
+        probe(only_tight, "glyphs_tight"),
+        0,
+        "the retained probe ignored its budget"
+    );
+    assert_ne!(
+        probe(only_camera_tight, "glyphs_camera"),
+        0,
+        "the camera probe ignored its budget"
+    );
+}
+
+#[test]
+fn every_clone_of_a_kit_shares_the_declaration_and_the_default_is_the_engines() {
+    let kit = Kit::new().unwrap();
+    assert_eq!(kit.plan_limits(), RenderPlanLimits::default());
+    let shared = kit.clone();
+    kit.request_plan_limits(roomy());
+    assert_eq!(shared.plan_limits(), roomy());
+    assert_eq!(Kit::new().unwrap().plan_limits(), RenderPlanLimits::default());
+}
