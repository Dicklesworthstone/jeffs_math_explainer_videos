-use explainer_kit::Chapter;
+use explainer_kit::{Chapter, Kit};
+use fmn::rendering::RenderPlanLimits;
+
+/// What a chapter that paints a colour picture declares in its `make`.
+///
+/// Knots only. A repaint holds twice a plate's live knots: at `PLATE_CELLS4`
+/// that is 2,150,602 for z² and 3,453,516 for the six panels of 05_9. Moving a
+/// plate's points is not covered: z² would need 1,073,108 retained segments, so
+/// `max_retained_segments` would have to rise as well, and the monotone table's
+/// own fixed limit would then apply.
+fn declare_plate_budget(kit: &Kit) {
+    kit.request_plan_limits(RenderPlanLimits {
+        max_retained_profile_knots: 1 << 22,
+        ..RenderPlanLimits::default()
+    });
+}
 
