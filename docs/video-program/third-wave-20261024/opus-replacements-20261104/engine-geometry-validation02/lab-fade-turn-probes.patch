+/// 11_7's picture of the division, the way `Turning` builds and turns it: a second full plate on
+/// top of the painter's, the painter fading out over it, then every cell recoloured in place at each
+/// step of the tracker. The output curve the film also moves is left out, since it holds no knots.
+fn turn(stage: &mut Stage<'_>, job: Job, seen: &mut Seen) -> fmn::Result<()> {
+    let plane = (job.subject.plane)();
+    let style = job.candidate.style;
+    let t = Instant::now();
+    let painter = Painter::build_styled(stage, Some(job.subject.func), plane, job.subject.enhance, style)?;
+    seen.build_s = t.elapsed().as_secs_f64();
+    stage.add_to_scene(painter.group)?;
+    stage.add_to_scene(painter.anchor)?;
+    wait_frames(stage, 1)?;
+
+    let func = job.subject.func;
+    let field = draw::portrait_styled(stage, func, &plane, job.subject.enhance, &style)?;
+    let rows = children(stage, field.group);
+    let before = sample_lanes(stage, &rows);
+    let group = field.group;
+    // the picture's own size: colours sized for any other plate would be refused, without a word
+    let (cols, cells_down) = draw::picture_cells(&plane, &style);
+    let turned = stage.add_value_tracker(0.0);
+    let anchor = stage.arena_mut().add(VMobject::new());
+    let mut last = 0.0;
+    stage.add_updater(
+        anchor,
+        move |s, _| {
+            let t = (draw::value(s, turned).clamp(0.0, 1.0) * TURN_STEPS).round() / TURN_STEPS;
+            if t == last {
+                return;
+            }
+            let by = C::polar(TURN_LEADING.abs().powf(t), TURN_LEADING.arg() * t);
+            let colors = draw::portrait_colors(|z| func.eval(z).map(|w| by * w), &plane, cols, cells_down, 1.0);
+            let _ = field.recolor(s, &colors);
+            last = t;
+        },
+        true,
+    )?;
+    stage.add_to_scene(group)?;
+    stage.add_to_scene(anchor)?;
+    painter.leave(stage, 1.0)?;
+    let seconds = TURN_REPAINTS as f64 / f64::from(job.kind.fps());
+    stage.play(tween(turned, 1.0, seconds)?)?;
+    seen.records = if same_colours(&before, &sample_lanes(stage, &rows), None) {
+        "TURN WROTE NOTHING"
+    } else {
+        "turned after the takeover"
+    };
+    Ok(())
+}
