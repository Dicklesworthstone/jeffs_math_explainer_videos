+/// The control's verdict. Being admitted, or refused for any other reason, stops the run. Being
+/// refused by name leaves the engine's own words beside where the frames would have gone.
+fn refused_by_name<E: std::fmt::Debug>(outcome: Result<u64, E>, dir: &Path) -> Result<&'static str, Box<dyn Error>> {
+    let error = match outcome {
+        Ok(frames) => {
+            return Err(format!("the control was admitted at {REFUSED_KNOTS} knots and wrote {frames} frames").into());
+        }
+        Err(error) => error,
+    };
+    let words = format!("{error:?}");
+    let named =
+        words.contains("resource: \"retained profile knots\"") && words.contains(&format!("limit: {REFUSED_KNOTS}"));
+    if !named {
+        return Err(format!("the control failed for another reason: {words}").into());
+    }
+    if dir.exists() {
+        return Err(format!("the refused control published {}", dir.display()).into());
+    }
+    let mut file = fs::File::create_new(dir.with_extension("txt"))?;
+    writeln!(file, "{words}")?;
+    println!("refused as it must be: {words}");
+    Ok("refused by name")
+}
