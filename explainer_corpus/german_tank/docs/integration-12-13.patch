+def exact_sqrt(x):
+    """The square root of a rational that is a perfect square (9/4 -> 3/2)."""
+    x = F(x)
+    a, b = isqrt(x.numerator), isqrt(x.denominator)
+    if a * a != x.numerator or b * b != x.denominator:
+        raise SystemExit(f"{x} is not a perfect square")
+    return F(a, b)
+
