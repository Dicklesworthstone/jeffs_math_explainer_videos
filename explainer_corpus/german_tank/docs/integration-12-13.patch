+    c_lhs = padd(n_sq, pmul(padd(n_, one, -1), padd(n_, k_, -1)), -1)
+    c_rhs = padd(pmul(padd(k_, one), n_), k_, -1)
+    d_rhs = padd(pmul(k_, n_), padd(n_, k_, -1))
+    return ok and c_lhs == c_rhs and c_rhs == d_rhs
