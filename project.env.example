# Per-machine settings for ./x (copy to project.env, which git ignores).
# The GPU host that runs narration, drafts and finals, and where this repo
# lives there (its rch shim, if any, sends builds to the worker fleet).
REMOTE_HOST=gpu-host
REMOTE_DIR=/data/projects/jeffs_math_explainer_videos
# Where the explainer skills are installed (contact sheets, verify scripts).
# SKILLS=$HOME/.claude/skills
